# GitHub Linguist policy: keep generated surfaces out of the language bar.
release/** linguist-generated=true
reports/** linguist-generated=true
data/** linguist-generated=true
content/development/*.json linguist-generated=true
apps/web/src/i18n/locales.js linguist-generated=true

# Local imported/snapshot copies are useful for comparison but not source language signal.
SE*S/** linguist-vendored=true

# Windows batch files must use CRLF line endings for correct GOTO/CALL label parsing.
*.bat text eol=crlf
