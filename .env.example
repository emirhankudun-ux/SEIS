# SEIS local environment template
# Copy to .env.local for local development. Keep real values out of Git.

# Core non-secret configuration
SEIS_ENVIRONMENT=local
SEIS_DATA_MODE=mock
SEIS_PRIVACY_MODE=local-only
SEIS_SITE_URL=https://example.com

# Local static server
SEIS_STATIC_ROOT=dist/seis-static
SEIS_WORKSPACE_ROOT=.
HOST=127.0.0.1
PORT=4177

# Optional automation switches
SEIS_PUBLISH_READINESS_FULL=0
SEIS_CONNECTOR_REPORT_REFRESH_TIMESTAMP=0
SEIS_CODE_PLAN_REFRESH_TIMESTAMP=0
SEIS_AUTO_COMMIT=0

# Optional deployment credentials
# Server-only. Configure through .env.local or a deployment secret manager.
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
AZURE_STATIC_WEB_APPS_API_TOKEN=
AWS_AMPLIFY_DEPLOY_TOKEN=
FIREBASE_DEPLOY_TOKEN=
