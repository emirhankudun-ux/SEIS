# SEIS Environment Configuration
# Copy to .env for local development. Never commit real credentials.

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
NODE_ENV=development
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------
# SEIS AI Core
# ------------------------------------------------------------
# Core SEIS must keep working with zero cloud provider keys.
# Provider/model selection belongs to registries and runtime settings.
SEIS_AI_MODE=local-demo
SEIS_AI_DEFAULT_PROVIDER=local-demo
SEIS_AI_ROUTING_MODE=manual
SEIS_AI_LOCAL_ONLY=1
AI_PROVIDER=local-demo

# ------------------------------------------------------------
# Cloud AI providers — all optional
# ------------------------------------------------------------
# Add only the credentials for providers you want to use.
# Presence of a key does not imply that a provider adapter is implemented.
# Secrets are server-side only; never expose them in frontend bundles.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DEFAULT_MODEL=
OPENAI_FAST_MODEL=

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=

# Google Gemini / AI Studio
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_DEFAULT_MODEL=

# xAI / Grok
XAI_API_KEY=
XAI_BASE_URL=
XAI_DEFAULT_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=

# Alibaba Cloud / Qwen / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_DEFAULT_MODEL=

# Moonshot AI / Kimi
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
KIMI_DEFAULT_MODEL=

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_DEFAULT_MODEL=

# Cohere
COHERE_API_KEY=
COHERE_BASE_URL=
COHERE_DEFAULT_MODEL=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_DEFAULT_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=MARIA-SEIS

# Together AI
TOGETHER_API_KEY=
TOGETHER_BASE_URL=
TOGETHER_DEFAULT_MODEL=

# Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
FIREWORKS_DEFAULT_MODEL=

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
CEREBRAS_DEFAULT_MODEL=

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_DEFAULT_MODEL=

# Perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=
PERPLEXITY_DEFAULT_MODEL=

# Hugging Face Inference
HF_TOKEN=
HF_INFERENCE_ENDPOINT=
HF_DEFAULT_MODEL=

# GitHub Models
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_BASE_URL=
GITHUB_MODELS_DEFAULT_MODEL=

# ------------------------------------------------------------
# Local / self-hosted providers — optional
# ------------------------------------------------------------
# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# LM Studio (OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_DEFAULT_MODEL=

# Generic OpenAI-compatible endpoint
# Useful for vLLM, llama.cpp server, LocalAI, text-generation-inference,
# compatible gateways, or private company endpoints.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DEFAULT_MODEL=

# ------------------------------------------------------------
# Optional provider routing controls
# ------------------------------------------------------------
# Comma-separated preference/fallback chains; runtime may ignore providers
# that are unavailable, unhealthy, unsupported, or missing credentials.
SEIS_AI_PROVIDER_ORDER=
SEIS_AI_FALLBACK_ORDER=
SEIS_AI_FORCE_OFFLINE=0
SEIS_AI_FORCE_ONLINE=0

# ------------------------------------------------------------
# Local static server / workspace
# ------------------------------------------------------------
SEIS_STATIC_ROOT=dist/seis-static
SEIS_WORKSPACE_ROOT=.
HOST=127.0.0.1
PORT=4177

# ------------------------------------------------------------
# Authentication / logging
# ------------------------------------------------------------
AUTH_TOKEN=
LOG_LEVEL=debug

# ------------------------------------------------------------
# Optional external coding-agent defaults
# ------------------------------------------------------------
# AIDER_MODEL=
# AIDER_EDITOR_MODEL=
