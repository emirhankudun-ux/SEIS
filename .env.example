# SEIS public-safe environment template
# Copy to .env.local for local experiments only. Do not commit filled values.
# Core SEIS and demo mode must work without cloud provider keys.

# Runtime mode
NODE_ENV=development
SEIS_AI_MODE=local-demo
SEIS_AI_DEFAULT_PROVIDER=local-demo
SEIS_AI_ROUTING_MODE=manual
SEIS_AI_LOCAL_ONLY=1

# Browser-visible demo URL. Do not put secrets in VITE_ variables.
VITE_API_URL=http://localhost:3000

# Optional cloud providers. Server-only; blank means disabled.
# These placeholders do not enable live provider support.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional provider model aliases. Keep empty until verified in live adapter docs.
OPENAI_DEFAULT_MODEL=
OPENAI_FAST_MODEL=
ANTHROPIC_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=

# Optional local provider. Ollama normally requires no API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# Local static server
SEIS_STATIC_ROOT=dist/seis-static
SEIS_WORKSPACE_ROOT=.
HOST=127.0.0.1
PORT=4177

# Optional server-only demo auth token. Leave blank unless a local-only test needs it.
AUTH_TOKEN=

# Logging
LOG_LEVEL=debug
