# New Project Environment Configuration

# Environment
NODE_ENV=development

# API Configuration
VITE_API_URL=http://localhost:3000

# Authentication
AUTH_TOKEN=your_token_here

# Logging
LOG_LEVEL=debug

# AI Providers (cloud)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AI Providers (local)
OLLAMA_HOST=http://127.0.0.1:11434
# Optional AI routing behavior controls
# AI_FORCE_OFFLINE=1   # Force offline preference for auto mode routing
# AI_FORCE_ONLINE=1    # Force online preference for auto mode routing

# Optional defaults for tool behavior
# AIDER_MODEL=openai/gpt-4.1-mini
# AIDER_EDITOR_MODEL=anthropic/claude-3-7-sonnet-latest
