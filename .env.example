# New Project Environment Configuration

# Environment
NODE_ENV=development

# API Configuration
VITE_API_URL=http://localhost:3000

# SEIS AI Core defaults
# Server-only. These model aliases do not enable live providers by themselves.
# Core SEIS must keep working with zero cloud provider keys.
SEIS_AI_MODE=local-demo
SEIS_AI_DEFAULT_PROVIDER=local-demo
SEIS_AI_ROUTING_MODE=manual
SEIS_AI_LOCAL_ONLY=1

# Optional OpenAI provider
# Verified current API model alias: gpt-5.5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini

# Optional Anthropic provider
# Verified current Opus alias: claude-opus-4-8
# The user-requested Opus 4.6 alias is kept as an explicit compatibility pin.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8
ANTHROPIC_REQUESTED_COMPAT_MODEL=claude-opus-4-6

# Optional Google Gemini provider
# Verified current Gemini 3.1 Pro preview model alias.
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.1-pro-preview
GEMINI_AGENTIC_TOOLS_MODEL=gemini-3.1-pro-preview-customtools

# Optional local provider
# Ollama normally requires no API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# Local static server
SEIS_STATIC_ROOT=dist/seis-static
SEIS_WORKSPACE_ROOT=.
HOST=127.0.0.1
PORT=4177

# Authentication
AUTH_TOKEN=

# Logging
LOG_LEVEL=debug

# SEIS AI model aliases
AI_PROVIDER=local-demo
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_REQUESTED_COMPAT_MODEL=claude-opus-4-6
GEMINI_MODEL=gemini-3.1-pro-preview
PORT=8000

# AI Providers (cloud)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AI Providers (local)
OLLAMA_HOST=http://127.0.0.1:11434
# Optional AI routing behavior controls
# AI_FORCE_OFFLINE=1   # Force offline preference for auto mode routing
# AI_FORCE_ONLINE=1    # Force online preference for auto mode routing

# Optional defaults for tool behavior
# AIDER_MODEL=openai/gpt-4.1-mini
# AIDER_EDITOR_MODEL=anthropic/claude-3-7-sonnet-latest
