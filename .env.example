# SEIS local environment template
# Copy to .env.local for local development. Keep real values out of Git.

# Core non-secret configuration
SEIS_ENVIRONMENT=local
SEIS_DATA_MODE=mock
SEIS_PRIVACY_MODE=local-only
SEIS_SITE_URL=https://example.com

# SEIS AI Core defaults
# Server-only. These model aliases do not enable live providers by themselves.
# Core SEIS must keep working with zero cloud provider keys.
SEIS_AI_MODE=local-demo
SEIS_AI_DEFAULT_PROVIDER=local-demo
SEIS_AI_ROUTING_MODE=manual
SEIS_AI_LOCAL_ONLY=1

# Optional OpenAI provider
# Server-only. Leave model fields empty unless the provider is explicitly enabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_DEFAULT_MODEL=
OPENAI_FAST_MODEL=

# Optional Anthropic provider
# Server-only. Do not label fallback output as Claude unless Anthropic is used.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_REQUESTED_COMPAT_MODEL=

# Optional Google Gemini provider
# Server-only. Confirm model aliases before enabling live routing.
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
GEMINI_AGENTIC_TOOLS_MODEL=

# Optional local provider
# Ollama normally requires no API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# Local static server
SEIS_STATIC_ROOT=dist/seis-static
SEIS_WORKSPACE_ROOT=.
HOST=127.0.0.1
PORT=4177

# Optional automation switches
SEIS_PUBLISH_READINESS_FULL=0
SEIS_CONNECTOR_REPORT_REFRESH_TIMESTAMP=0
SEIS_CODE_PLAN_REFRESH_TIMESTAMP=0
SEIS_AUTO_COMMIT=0

# Optional deployment credentials
# Server-only. Configure through .env.local or a deployment secret manager.
GITHUB_TOKEN=
CLOUDFLARE_API_TOKEN=
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
AZURE_STATIC_WEB_APPS_API_TOKEN=
AWS_AMPLIFY_DEPLOY_TOKEN=
FIREBASE_DEPLOY_TOKEN=
