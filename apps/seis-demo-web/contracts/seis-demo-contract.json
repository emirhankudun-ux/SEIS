{
  "contract_version": "1.0.0",
  "contract_name": "SEIS Demo Shared Contract",
  "platform_targets": ["iOS", "macOS", "web"],
  "routes": [
    { "path": "/", "view": "home", "title": "Home", "description": "Landing surface and status." },
    { "path": "/demo", "view": "demo", "title": "Demo", "description": "Scenario list and launch." },
    { "path": "/demo/:scenario", "view": "scenario", "title": "Scenario", "description": "Scenario detail and actions." },
    { "path": "/results/:runId", "view": "results", "title": "Results", "description": "Run report and timeline." }
  ],
  "scenarios": [
    {
      "id": "governance-router",
      "title": "Governance Routing + Specialist Dispatch",
      "summary": "Checks open-source policy and dispatches specialist lanes.",
      "specialist": "AI Policy",
      "defaultPrompt": "Run a cross-platform policy and specialist readiness check for the current run.",
      "steps": [
        "Read and validate governance inputs",
        "Resolve candidate specialist lanes",
        "Generate policy-aligned readiness report"
      ]
    },
    {
      "id": "pipeline-speed",
      "title": "Pipeline Speed Demo",
      "summary": "Profiles route latency and quality gates for macOS/iOS demos.",
      "specialist": "Ops/Quality",
      "defaultPrompt": "Measure start-to-result latency for the route and specialist calls.",
      "steps": [
        "Initialize route tracking",
        "Execute quality checks",
        "Build performance breakdown"
      ]
    },
    {
      "id": "agent-orchestration",
      "title": "Agent Orchestration Scenario",
      "summary": "Runs multi-lane specialist request flow and records conversion milestones.",
      "specialist": "SEIS Agent",
      "defaultPrompt": "Simulate multi-lane specialist orchestration for a feature request.",
      "steps": [
        "Create dispatch request",
        "Route to selected specialists",
        "Consolidate artifact outputs"
      ]
    }
  ],
  "analytics_events": [
