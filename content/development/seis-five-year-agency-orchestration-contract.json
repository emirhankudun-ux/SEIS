{
  "$schema": "https://seis.dev/schemas/five-year-agency-orchestration-contract.schema.json",
  "id": "seis-five-year-agency-orchestration-contract",
  "version": "2026-07-03",
  "status": "draft-public-safe",
  "visibility": "public-safe",
  "mode": "agency-grade-supervised-continuation",
  "objective": "Turn the five-year SEIS development model into a repo-tracked operating contract that coordinates agents, tools, MCP policy, source provenance, AI Core boundaries, Apple-first work, SEIS Brain work, verification, and PR-sized execution without claiming uncontrolled autonomy.",
  "decisionMatrix": {
    "fiveYearDevelopmentModel": [
      "roadmap-pr-cycles",
      "real-automation-architecture",
      "active-background-agents-when-platform-permits"
    ],
    "mcpPolicy": [
      "official-or-approved-mcp-only-for-activation",
      "installed-safe-mcps-after-verification",
      "candidate-ecosystem-pool-as-documentation"
    ],
    "skillsAndPlugins": [
      "task-selected",
      "registry-inventory",
      "reselected-each-swarm-round-when-safe"
    ],
    "firstMilestone": [
      "source-inventory-and-provenance",
      "demo-ux-adaptation",
      "swift-apple-bridge"
    ],
    "zipUseRule": [
      "originals-immutable-manifest-only",
      "selected-public-safe-assets-only-after-review",
      "full-reference-dump-is-manifest-level-until-license-and-size-review"
    ],
    "kimiPackages": [
      "v1-v7-included",
      "v1-v4-preserved-as-early-evolution-evidence",
      "v7-primary-reference"
    ],
    "stitchSources": [
      "ux-screen-catalog",
      "module-idea-pool",
      "read-only-code-reference-no-direct-copy"
    ],
    "firstPrSize": [
      "small-safe-first-slice",
      "medium-follow-up-slices",
      "large-foundation-split-into-reviewed-work-packages"
    ],
    "swiftPriority": [
      "swift-model-and-manifest-first",
      "swiftui-shell-next",
      "roadmap-stays-current"
    ],
    "webDemoPriority": [
      "preserve-current-demo",
      "new-seis-os-workspace-only-behind-safe-scope",
      "stitch-derived-module-gallery-after-review"
    ],
    "aiCoreBoundary": [
      "demo-only-no-fake-live-ai",
      "local-ai-ready-metadata",
      "cloud-provider-ready-keys-free-metadata"
    ],
    "agentSwarmVisibility": [
      "ledger-and-report",
      "ui-agent-panel-planned",
      "seis-brain-context-pack"
    ],
    "seisBrain": [
      "source-inventory-note",
      "adr",
      "five-year-roadmap-context-pack"
    ],
    "verification": [
      "existing-npm-node-checks",
      "swift-checks-when-swift-is-touched",
      "new-provenance-and-orchestration-checkers"
    ],
    "security": [
      "secret-scan-and-public-safe-manifest",
      "mcp-permission-risk-matrix",
      "zip-license-and-size-risk-review"
    ],
    "finalOutput": [
      "decision-complete-plan",
      "pr-ready-work-breakdown",
      "thirty-round-swarm-backlog"
    ]
  },
  "cycleContract": {
    "years": 5,
    "roundsPerRun": 30,
    "stepsPerProgram": 50,
    "ownerSelectedThirtyRoundRun": true,
    "legacySwarmLedgerDefaultRounds": 15,
    "executionLoop": [
      "inspect",
      "assign",
      "build",
      "verify",
      "document",
      "report",
      "continue"
    ],
    "literalContinuousRuntimeClaimAllowed": false,
    "backgroundAgents": "platform-dependent",
    "fallbackWhenBackgroundAgentsUnavailable": "Use repo-tracked ledgers, manifests, context packs, and checkers to preserve continuity between supervised runs.",
    "singleRunCompletionRule": "One run is complete only after its scoped evidence, docs, and verification are updated or explicitly marked blocked."
  },
  "truthBoundary": {
    "liveAiClaimAllowed": false,
    "mcpInstallClaimAllowedWithoutVerification": false,
    "credentialStorageAllowed": false,
    "externalMutationRequiresApproval": true,
    "singleWriterMode": "codex-primary-writer",
    "subagentsMayWrite": false,
    "subagentsMayInspect": true,
    "providerCallsAllowed": false,
    "demoModeMustRemainNoKey": true,
    "rawArchiveDumpAllowedWithoutReview": false
  },
  "sourceOfTruth": {
    "fiveYearPlan": "content/development/seis-sub-agent-5-year-plan.json",
    "sourceProvenance": "content/development/seis-source-provenance-intake.json",
    "installedTools": "content/development/seis-installed-ai-tools-registry.json",
    "pluginIntegration": "content/development/seis-agent-plugin-integration.json",
    "subagentOperatingModel": "content/development/seis-ai-core-subagent-operating-model.json",
    "mcpRuntimeContract": "content/development/seis-ai-core-mcp-runtime-contract.json",
    "providerRegistry": "content/development/seis-ai-core-provider-registry.json",
    "sourceProvenanceChecker": "scripts/check-seis-source-provenance-intake.mjs",
    "subagentOperatingModelChecker": "scripts/check-seis-ai-core-subagent-operating-model.mjs",
    "constitution": "AGENTS.md"
  },
  "mcpPolicy": {
    "activationDefault": "official-or-owner-approved-only",
    "installedMcpUse": "verified-only",
    "candidateUse": "document-only-until-reviewed",
    "packageRunnerDefault": "disabled-or-approval-gated",
    "permissionReviewRequired": true,
    "secretBoundary": "No API keys, tokens, private keys, or real SSH hosts may be stored in public repo files.",
    "riskMatrixDimensions": [
      "source",
      "officialStatus",
      "permissions",
      "authentication",
      "secretRequirement",
      "externalMutationRisk",
      "publicRepoSafety",
      "seisValue",
      "recommendedPriority"
    ]
  },
