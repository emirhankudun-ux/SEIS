  "toolFeatureAssignments": [
    {
      "toolId": "codex-current-session",
      "statusClass": "available-primary",
      "allowedMode": "primary-writer-and-verifier",
      "developsFeatures": [
        "repo-edits",
        "validators",
        "reports",
        "subagent-coordination"
      ],
      "evidenceRequired": "Tool execution transcript and changed files."
    },
    {
      "toolId": "xcode-seis-platform-swift",
      "statusClass": "available",
      "allowedMode": "swift-checker-when-swift-touched",
      "developsFeatures": [
        "swift-models",
        "swiftui-shell",
        "apple-native-readiness"
      ],
      "evidenceRequired": "swift package describe/build/test output when Swift files are changed."
    },
    {
      "toolId": "claude-code-cli-auth-gated",
      "statusClass": "available-review-candidate",
      "allowedMode": "review-or-plan-only-until-auth-and-scope-confirmed",
      "developsFeatures": [
        "architecture-review",
        "documentation-review",
        "governance-review"
      ],
      "evidenceRequired": "Auth and invocation evidence before any claim of use."
    },
    {
      "toolId": "gemini-cli-auth-gated",
      "statusClass": "manual",
      "allowedMode": "research-review-only",
      "developsFeatures": [
        "research-cross-check",
        "mcp-candidate-analysis",
        "apple-platform-notes"
      ],
      "evidenceRequired": "Manual auth and explicit reviewed outputs."
    },
    {
      "toolId": "kimi-code-cli-login-required",
      "statusClass": "manual",
      "allowedMode": "read-only-review-until-login",
      "developsFeatures": [
        "kimi-package-comparison",
        "multilingual-review",
        "source-evolution-notes"
      ],
      "evidenceRequired": "Login-ready status and read-only review outputs."
    },
    {
      "toolId": "cursor-desktop-secondary-review",
      "statusClass": "available",
      "allowedMode": "secondary-ide-review",
      "developsFeatures": [
        "ux-review",
        "code-navigation",
        "design-system-review"
      ],
      "evidenceRequired": "Manual review notes or linked diffs."
    },
    {
      "toolId": "lm-studio-local-model-lab",
      "statusClass": "available-local-lab",
      "allowedMode": "local-ai-readiness-metadata",
      "developsFeatures": [
        "local-provider-readiness",
        "offline-model-notes",
        "privacy-first-ai-lab"
      ],
      "evidenceRequired": "Local endpoint/model availability check before runtime claim."
    },
    {
      "toolId": "openai-cli-auth-gated",
      "statusClass": "manual",
      "allowedMode": "keys-free-docs-and-auth-gated-utility",
      "developsFeatures": [
        "provider-metadata",
        "api-boundary-docs",
        "prompt-engine-notes"
      ],
      "evidenceRequired": "No public repo key storage; auth evidence only outside repo."
    },
    {
      "toolId": "aider-cli-patch-helper",
      "statusClass": "manual",
      "allowedMode": "bounded-patch-helper",
      "developsFeatures": [
        "small-refactors",
        "test-focused-patches",
        "reviewable-fixes"
      ],
      "evidenceRequired": "Diff and checks from bounded invocation."
    },
    {
      "toolId": "goose-cli-automation-helper",
      "statusClass": "manual",
      "allowedMode": "approval-gated-automation",
      "developsFeatures": [
        "repeatable-local-automation",
        "report-generation",
        "safe-scripts"
      ],
      "evidenceRequired": "Approval and command transcript for mutations."
    },
    {
      "toolId": "hermes-desktop-auth-gated",
      "statusClass": "available-review-candidate",
      "allowedMode": "bounded-review-candidate",
      "developsFeatures": [
        "provider-route-review",
        "ai-tool-status",
        "manual-readiness-report"
      ],
      "evidenceRequired": "Route readiness output; failed auth must be reported honestly."
    }
  ],
  "runTemplate": {
    "rounds": [
      {
        "round": 1,
        "department": "strategy-office",
        "focus": "Confirm AGENTS.md scope, current branch, dirty tree, and safest PR slice.",
        "output": "Run kickoff ledger",
        "verification": "git status and relevant file inspection"
      },
      {
        "round": 2,
        "department": "data-provenance",
        "focus": "Refresh Kimi and Stitch source inventory without mutating original archives.",
        "output": "Provenance delta note",
        "verification": "source provenance checker"
      },
      {
        "round": 3,
        "department": "security-qa",
        "focus": "Scan touched files for local paths, tokens, private keys, and unsafe archive dumps.",
        "output": "Public-safe risk note",
        "verification": "targeted ripgrep scan"
      },
      {
        "round": 4,
        "department": "engineering-studio",
        "focus": "Implement the smallest contract, schema, checker, or docs improvement.",
        "output": "Reviewable diff",
        "verification": "node checker or existing npm script"
      },
      {
        "round": 5,
        "department": "ai-core-lab",
        "focus": "Update demo/live, local-ready, and cloud-ready metadata without provider calls.",
        "output": "AI Core boundary delta",
        "verification": "truth boundary checker"
      },
      {
        "round": 6,
        "department": "creative-studio",
        "focus": "Map Stitch UX signals into a public-safe screen or module catalog.",
        "output": "UX catalog entry",
        "verification": "documentation review"
      },
      {
        "round": 7,
        "department": "engineering-studio",
        "focus": "Strengthen Swift or manifest bridge only when it adds real Apple-first value.",
        "output": "Swift-ready handoff",
        "verification": "Swift checks when Swift is touched"
      },
      {
        "round": 8,
        "department": "automation-office",
        "focus": "Refresh or add bounded validation scripts for the current evidence.",
        "output": "Checker update",
        "verification": "direct checker run"
      },
      {
        "round": 9,
        "department": "research-intelligence",
        "focus": "Review MCP, skills, and plugin candidates as documentation-only unless approved.",
        "output": "Candidate risk note",
        "verification": "no install or enable claim without proof"
      },
      {
        "round": 10,
        "department": "release-governance",
        "focus": "Split oversized work into PR-ready packages.",
        "output": "PR split note",
        "verification": "files changed remain reviewable"
      },
      {
        "round": 11,
        "department": "strategy-office",
        "focus": "Re-evaluate highest-value next slice against the 50-step ladder.",
        "output": "Next slice selection",
        "verification": "contract checker"
      },
      {
        "round": 12,
        "department": "data-provenance",
        "focus": "Compare Kimi v7 against v1-v6 as evolution evidence.",
        "output": "Kimi lineage delta",
        "verification": "no raw code copy without review"
      },
      {
        "round": 13,
        "department": "creative-studio",
        "focus": "Convert approved UX patterns into SEIS-native, icon-first concepts.",
        "output": "SEIS UX concept note",
        "verification": "accessibility checklist"
      },
      {
        "round": 14,
        "department": "ai-core-lab",
        "focus": "Clarify provider, model, prompt, memory, and router boundaries.",
        "output": "AI Core ledger entry",
        "verification": "no fake-live wording"
      },
      {
        "round": 15,
        "department": "security-qa",
