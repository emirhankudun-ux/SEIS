{
  "schemaVersion": 1,
  "id": "seis-fullstack-contract",
  "updated": "2026-07-14",
  "status": "validated-contract",
  "mode": "local-demo-no-key-fullstack-foundation",
  "qualityGate": "npm run check:seis-fullstack-contract",
  "runtimeGate": "npm run check:seis-fullstack-server-smoke",
  "fallbackGate": "npm run check:seis-fullstack-no-server-fallback-smoke",
  "coreCredentialRequirement": "none",
  "liveCredentialRequirement": "optional-backend-only-after-approval",
  "localDemoFirst": true,
  "staticDemoFallbackRequired": true,
  "description": "SEIS full-stack foundation contract for the first safe server/API/data boundary. It preserves the current static demo and defines read-only Local Demo data before auth, database, live AI, SSH, or deployment work.",
  "sourceOfTruth": {
    "contract": "content/development/seis-fullstack-contract.json",
    "server": "server/node/static-server.mjs",
    "architectureDoc": "docs/architecture/seis-full-stack-transition.md",
    "laneDoc": "apps/fullstack/README.md",
    "status": "docs/STATUS.md",
    "backlog": "docs/roadmap/MASTER_BACKLOG.md",
    "nextPrQueue": "docs/roadmap/NEXT_PR_QUEUE.md"
  },
  "securityInvariants": [
    "Core SEIS must start with zero cloud provider keys.",
    "Provider secrets must never be stored in browser localStorage, IndexedDB, route config, static JSON, or frontend bundles.",
    "Live provider requests must be backend-only after explicit approval and redacted audit logging.",
    "SSH, deployment, Git push, merge, and file deletion remain disabled until explicitly approved.",
    "Local Demo fallback must remain available when every optional provider key is missing."
  ],
  "frontendState": {
    "currentStorage": [
      "localStorage",
      "IndexedDB browser-local VFS"
    ],
    "allowedClientPersistence": [
      "locale preference",
      "theme preference",
      "window/session geometry",
      "browser-local VFS demo files",
      "Local Demo app install toggles"
    ],
    "forbiddenClientPersistence": [
      "API keys",
      "tokens",
      "passwords",
      "SSH private keys",
      "service accounts",
      "provider credentials",
      "private host fingerprints",
      "cookies copied from external services"
    ],
    "fallbackContract": "Every frontend surface must still render and respond without the server endpoints, external network, auth, provider keys, SSH, or deployment."
  },
  "serverBoundary": {
    "runtime": "node:http static server",
    "dependencyPolicy": "no-new-dependencies-first",
    "writePolicy": "read-only endpoints for first contract slice",
    "storagePolicy": "fixture-backed Local Demo JSON until database/auth approval",
    "secretPolicy": "server-only environment presence and shape may be inspected through a redacted validator, but values must never be serialized or authenticated",
    "approvalRequiredFor": [
      "new runtime dependencies",
      "external database",
      "authentication provider",
      "live AI provider calls",
      "SSH execution",
      "deployment",
      "GitHub write actions",
      "real credential handling"
    ]
  },
  "providerEnvironmentValidation": {
    "id": "seis-ai-core-provider-environment-validation",
    "schemaVersion": "1.0.0",
    "source": "packages/seis-ai/src/provider/provider-env-validation.mjs",
    "mode": "server-only-presence-and-shape",
    "status": "server-runtime-derived-redacted-report",
    "secretValuesReturned": false,
    "secretValuesLogged": false,
    "credentialAuthenticationPerformed": false,
    "networkCalled": false,
    "externalMutationPerformed": false,
    "liveRoutingEnabled": false,
    "statusBoundary": "Presence and shape only; Missing Key and Disabled providers remain non-routable."
  },
  "publicEndpoints": [
    {
      "route": "/_server/session",
      "method": "GET",
      "sourceKey": "session",
