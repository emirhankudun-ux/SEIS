{
  "version": 2,
  "id": "seis-trusted-marketplace-plugin",
  "status": "public-repository-successor",
  "summary": "Bind the public SEIS Trusted Marketplace plugin to the SEIS Repo marketplace so curated source review remains visible without preserving a legacy installation surface.",
  "plugin": {
    "name": "seis-trusted-marketplace",
    "displayName": "SEIS Trusted Marketplace",
    "marketplaceName": "seis-repo",
    "marketplacePath": ".agents/plugins/marketplace.json",
    "sourcePath": "plugins/seis-core/seis-trusted-marketplace",
    "publicAudience": "everyone",
    "publicMarketplace": true,
    "activationPolicy": "approval-gated"
  },
  "pluginRepository": {
    "name": "SEIS",
    "mode": "public-repository-app-owned",
    "canonicalRepository": "SEIS",
    "sourcePath": "plugins/seis-core/seis-trusted-marketplace",
    "githubRemote": "https://github.com/emirhankudun-ux/SEIS.git",
    "public": true
  },
  "repository": {
    "name": "SEIS",
    "githubRemote": "https://github.com/emirhankudun-ux/SEIS.git",
    "canonicalBranch": "main"
  },
  "repoContracts": [
    ".agents/plugins/marketplace.json",
    "content/development/trusted-marketplace-intake.json",
    "content/development/plugin-capability-catalog.json",
    "docs/development/trusted-marketplace-intake.md",
    "docs/development/aggressive-capability-activation.md"
  ],
  "qualityCommands": [
    "npm run check:trusted-marketplace-intake",
    "npm run check:seis-trusted-marketplace-plugin",
    "npm run check:seis-core-trusted-marketplace",
    "npm run check:seis-repo-marketplace"
  ],
  "pluginQualityCommands": [
    "node plugins/seis-core/seis-trusted-marketplace/scripts/seis-trusted-marketplace-mcp-server.mjs --status",
    "node plugins/seis-core/seis-trusted-marketplace/scripts/seis-trusted-marketplace-mcp-server.mjs --validate",
    "node --test plugins/seis-core/test/trusted-marketplace.test.mjs"
  ],
  "capabilityLanes": [
    "data-engineering",
    "development",
    "design",
    "learning",
    "monitoring",
    "productivity",
    "security",
    "testing"
  ],
  "bridgeHealthChecks": [
    "public-manifest-parity",
    "seis-repo-marketplace-binding",
    "read-only-permission-boundary",
    "machine-path-exclusion",
    "approval-gated-activation"
  ],
  "designerWorkflow": [
    "Open the SEIS Trusted Marketplace card from SEIS Repo.",
    "Choose one capability lane before proposing any external source or connector.",
    "Review trust posture, scope, and user-facing value before activation.",
    "Keep installs, credentials, external writes, and publication blocked until target, authorization, approval, and rollback are explicit.",
    "Run the repository validation before handing off a trusted-source decision."
  ],
  "activationBoundary": {
    "externalActivation": "approval-required",
    "network": "disabled-by-default",
    "secrets": "not-read",
    "writes": "disabled-by-default",
    "publicReleaseAllowed": false
  },
  "migration": {
    "legacySourceDirectory": "seis-trusted-marketplace-plugin",
    "legacyMode": "archived-non-active-reference",
    "legacyInstallationMutation": false,
    "replacement": "plugins/seis-core/seis-trusted-marketplace"
  },
  "safetyRules": [
    "Keep the public marketplace source path relative to the SEIS repository.",
    "Do not store user machine paths, credentials, tokens, or external service configuration in this contract.",
    "Do not activate external marketplace sources from this plugin.",
    "Preserve legacy source history without presenting it as an active installation surface."
  ]
}
