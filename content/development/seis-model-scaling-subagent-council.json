      "allowedActions": ["inspect docs", "draft doc updates", "report stale claims"],
      "forbiddenActions": ["document fake benchmark results", "hide missing approvals", "publish fake model cards"],
      "requiredEvidence": ["docs index", "status doc", "review doc"],
