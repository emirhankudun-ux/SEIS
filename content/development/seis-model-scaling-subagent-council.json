{
  "id": "seis-model-scaling-subagent-council",
  "version": "2026.06.24",
  "status": "active-plan-only",
  "updatedAt": "2026-06-24",
  "qualityGate": "npm run check:seis-model-scaling-subagent-council",
  "purpose": "Bind the full SEIS sub-agent set to the 20B local compatibility target, 70B research lane, 150B frontier lane, 512B AGI apex program, and higher-parameter roadmap without granting runtime, training, provider, SSH, cloud, or GitHub mutation authority.",
  "truthBoundary": "Sub-agent council contract only. It does not run agents, download models, download datasets, train, fine-tune, benchmark memory, call providers, execute SSH, provision cloud/GPU resources, publish checkpoints, or claim SEIS owns trained 20B, 70B, 150B, 512B, AGI, or larger foundation-model weights.",
  "runtimeBoundary": "status-and-plan-only",
  "coreCredentialRequirement": "none",
  "defaultRuntimeMode": "seis-local-demo",
  "routeEligibleToday": false,
  "sourceOfTruth": {
    "modelScalingProfile": "content/development/seis-model-scaling-hardware-profile.json",
    "parameterLadder": "content/development/seis-model-parameter-ladder.json",
    "frontierModelProgram": "content/development/seis-150b-frontier-model-program.json",
    "apexModelProgram": "content/development/seis-512b-apex-model-program.json",
    "frontierEscalationPolicy": "content/development/seis-model-frontier-escalation-policy.json",
    "benchmarkDryRun": "reports/seis-model-scaling/20b-benchmark-dry-run.json",
    "benchmarkManifest": "reports/seis-model-scaling/20b-16gb-memory-benchmark.json",
    "modelCardTemplate": "content/development/seis-20b-model-card-template.json",
    "datasetCardTemplate": "content/development/seis-20b-dataset-card-template.json",
    "subagentOperatingModel": "content/development/seis-ai-core-subagent-operating-model.json",
    "aiCoreDoc": "docs/ai/seis-ai-core.md",
    "modelScalingDoc": "docs/ai/seis-model-scaling.md"
  },
  "councilRules": [
    {
      "id": "no-runtime-authority",
      "rule": "Council agents may report status and produce plans, but may not execute real model runtime, benchmark, training, provider, SSH, deployment, or cloud/GPU actions.",
      "status": "active"
    },
    {
      "id": "20b-first",
      "rule": "70B, 150B, 300B+, 512B, AGI, and highest-future work remains blocked until 20B evidence is complete and reviewed.",
      "status": "active"
    },
    {
      "id": "evidence-before-claim",
      "rule": "Any model ownership, compatibility, benchmark, inference, fine-tune, checkpoint, or training claim requires matching evidence before it can be surfaced.",
      "status": "active"
    },
    {
      "id": "local-demo-fallback",
      "rule": "Missing model, provider key, benchmark, or approval must fall back to SEIS Local Demo without silent cloud provider routing.",
      "status": "active"
    }
  ],
  "agents": [
    {
      "id": "architect-agent",
      "displayName": "Architect Agent",
      "lane": "architecture",
      "authority": "plan-only",
      "primaryDuty": "Maintain the 20B-first architecture, promotion gates, non-claim boundaries, and 70B/150B escalation sequence.",
      "allowedActions": ["read scaling contracts", "draft architecture plans", "map evidence gaps"],
      "forbiddenActions": ["approve route eligibility", "claim trained weights", "expand permissions"],
      "requiredEvidence": ["model scaling profile", "frontier escalation policy", "parameter ladder"],
      "validationGate": "npm run check:seis-model-scaling-hardware-profile"
    },
    {
      "id": "code-agent",
      "displayName": "Code Agent",
      "lane": "engineering",
      "authority": "plan-only",
      "primaryDuty": "Keep validators, MCP payloads, and Command Center model-scaling surfaces synchronized with source contracts.",
      "allowedActions": ["read code paths", "draft scoped implementation plan", "identify validator coverage"],
      "forbiddenActions": ["install dependencies", "download weights", "run unapproved benchmarks"],
      "requiredEvidence": ["validator output", "MCP smoke coverage", "git diff scope"],
