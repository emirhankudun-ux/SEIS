    },
    {
      "id": "qa-agent",
      "displayName": "QA Agent",
      "lane": "quality",
      "authority": "plan-only",
      "primaryDuty": "Prove validator coverage for the 20B planning floor, 70B research gate, 150B frontier gate, and no-skip policy.",
      "allowedActions": ["run safe local validators", "compare expected evidence", "report gaps"],
      "forbiddenActions": ["claim unrun tests passed", "replace broad checks with narrow checks", "ignore dirty-tree risk"],
      "requiredEvidence": ["validator command", "pass/fail result", "scope note"],
      "validationGate": "npm run check:seis-model-frontier-escalation-policy"
    },
    {
      "id": "cloud-agent",
      "displayName": "Cloud Agent",
      "lane": "cloud",
      "authority": "plan-only",
      "primaryDuty": "Keep 150B distributed/cloud research disabled until cost, privacy, safety, observability, rollback, and approval evidence exists.",
      "allowedActions": ["draft cloud readiness plan", "draft cost boundary", "draft SSH-disabled status"],
      "forbiddenActions": ["execute SSH", "deploy", "create cloud resources", "store provider keys"],
      "requiredEvidence": ["cloud approval boundary", "rollback owner", "cost ceiling plan"],
      "validationGate": "npm run check:cloud-access-policy"
    },
    {
      "id": "automation-agent",
      "displayName": "Automation Agent",
      "lane": "automation",
      "authority": "plan-only",
      "primaryDuty": "Keep generation scripts, stale-report checks, quality gates, and non-claim validators synchronized.",
      "allowedActions": ["inspect scripts", "draft automation plan", "report stale generated artifacts"],
      "forbiddenActions": ["run destructive automation", "auto-push", "auto-merge", "auto-deploy"],
      "requiredEvidence": ["script path", "quality gate", "stale check result"],
      "validationGate": "npm run check:seis-model-scaling-subagent-council"
    }
