    "preferenceRules": [
      {
        "priority": 1,
        "id": "global-governance-first",
        "rule": "AGENTS.md governs all repository agent behavior and cannot be weakened by this registry or a scoped source contract."
      },
      {
        "priority": 2,
        "id": "scoped-contracts-own-records",
        "rule": "Each source contract remains authoritative for records in its declared scope; this registry must preserve exact source parity."
      },
      {
        "priority": 3,
        "id": "registry-for-machine-consumers",
        "rule": "Machine consumers use this registry as the canonical aggregate and follow its source references when a scoped record changes."
      },
      {
        "priority": 4,
        "id": "workforce-policy-for-human-guidance",
        "rule": "SEIS_AGENT_WORKFORCE.md remains the human-readable workforce policy and does not replace scoped machine-readable inventories."
      },
      {
        "priority": 5,
        "id": "strictest-safety-boundary-wins",
        "rule": "When sources overlap or appear ambiguous, preserve the stricter no-secret, no-live-execution, single-writer, and human-approval boundary."
      },
      {
        "priority": 6,
        "id": "no-cross-roster-inference",
        "rule": "The nine Second Brain managed lanes and thirteen Second Brain agent roles are independent scoped rosters; no mapping between them is declared or implied."
      }
    ]
  },
