  "truthBoundary": {
    "classification": "public-safe",
    "sourceBacked": true,
    "sourceParityRequired": true,
    "inventoriesAreIndependent": true,
    "nineManagedLanesToThirteenAgentRolesMappingDeclared": false,
    "inferredCrossInventoryMappingAllowed": false,
    "excludedContent": [
      "local app inventory",
      "absolute vault paths",
      "credentials or secrets",
      "provider authentication state",
      "prompt bodies",
      "private content"
