    "currentKnownBlocker": "mobile-24x7-requires-direct-cloud-transport",
    "requiresFinalGate": "npm run cloud:ssh:mobile-direct:doctor:strict",
    "generatedBy": "apps/seis-core/cloud-ssh-center.js",
    "remoteMutationAllowed": false,
    "credentialRead": false,
    "secretStored": false
  },
