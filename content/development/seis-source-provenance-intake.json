    {
      "topic": "agentSwarmVisibility",
      "selected": ["A", "B", "C"],
      "resolution": "Use ledgers and reports first, then UI agent panel and SEIS Brain context pack follow-ups."
    },
    {
      "topic": "seisBrain",
      "selected": ["A", "B", "C"],
      "resolution": "Add a source inventory note, ADR, and five-year roadmap context pack."
    },
    {
      "topic": "verification",
      "selected": ["A", "B", "C"],
      "resolution": "Run existing npm/node checks where scoped, add Swift checks when touching Swift, and introduce a provenance checker."
    },
    {
      "topic": "security",
      "selected": ["A", "B", "C"],
      "resolution": "Use secret/public-safe checks, MCP permission risk matrix, and zip license/size risk review."
    },
    {
      "topic": "finalOutputType",
