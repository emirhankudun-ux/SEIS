    "w64RoutingOrderReport": "reports/seis-ai-routing/w64-provider-routing-order.md"
  },
  "truthBoundary": "Repository-local provider status fixture only. It performs no live provider calls, no credential validation, no network health checks, no SSH checks, no deployment, and no GitHub mutation.",
  "publicStates": [
    "Available",
    "Missing Key",
    "Disabled",
    "Rate Limited",
    "Error"
  ],
  "stateModel": [
    {
      "state": "Available",
      "routingEligible": true,
      "meaning": "The route can be used inside the declared local or supervised boundary without additional credentials."
    },
    {
      "state": "Missing Key",
      "routingEligible": false,
      "meaning": "A server-only credential is absent or unverified; the provider must not be selected."
    },
    {
      "state": "Disabled",
      "routingEligible": false,
      "meaning": "The provider or profile is intentionally unavailable for this demo slice."
    },
    {
      "state": "Rate Limited",
      "routingEligible": false,
      "meaning": "Future live adapter state for quota exhaustion; no current provider is marked rate limited by this offline fixture."
    },
    {
      "state": "Error",
      "routingEligible": false,
      "meaning": "Future live adapter state for redacted provider/runtime errors; no raw provider error body may be surfaced."
    }
  ],
  "providerReadinessAxes": [
    {
      "axis": "installed",
      "meaning": "The local app, CLI, adapter, or repo fixture needed for the route is present; this fixture does not install software."
    },
    {
      "axis": "credentialed",
      "meaning": "The route either requires no credential or has server-only credential evidence; this fixture does not read secrets."
    },
    {
      "axis": "quotaReady",
      "meaning": "The route is not known to be rate limited; live quota must be proven by a redacted server-only adapter later."
    },
    {
      "axis": "ownerApproved",
      "meaning": "The owner has approved the route for this lane or class of work."
    },
    {
      "axis": "verified",
      "meaning": "The route has repo-local evidence or a future redacted health check; this fixture performs no provider call."
    },
    {
      "axis": "blocked",
      "meaning": "The route must not be selected while any required readiness axis is false."
    }
  ],
  "routingPriority": {
    "mode": "local-first-when-adequate",
    "selectionOrder": [
      "adequate-local-provider",
      "owner-selected-provider",
      "capability-compatible-approved-cloud-provider",
      "lowest-risk-approved-cloud-provider",
      "lowest-cost-approved-cloud-provider",
      "seis-local-demo",
      "feature-disabled"
    ],
    "eligibilityRule": "A provider can route only when installed, credentialed, quotaReady, ownerApproved, and verified are true, blocked is false, and the provider supports the requested capability and privacy mode.",
    "limitHandling": "If the selected provider becomes Rate Limited or Error in a future live adapter, mark that provider blocked for the decision, record the redacted reason, and move visibly to the next eligible provider. Do not silently switch providers."
  },
  "coreCredentialRequirement": "none",
  "defaultRoutingMode": "local-demo",
  "localOnlyRespected": true,
  "requiredForCore": [],
  "fallbackOrder": [
    "adequate-local-provider",
    "owner-selected-provider",
    "capability-compatible-approved-cloud-provider",
    "lowest-risk-approved-cloud-provider",
    "lowest-cost-approved-cloud-provider",
    "approved-local-provider",
    "seis-local-demo",
    "local-demo",
    "feature-disabled"
  ],
