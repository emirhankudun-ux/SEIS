{
  "version": 1,
  "id": "seis-connector-capability-registry",
  "mode": "explicit-auth-only",
  "policy": {
    "default": "available_when_authenticated",
    "secretHandling": "never_commit_tokens",
    "execution": "use_only_when_relevant_to_the_current_task",
    "mcp": "prefer_official_or_project_configured_servers",
    "plugins": "route_by_capability_family_before_live_use",
    "skills": "load_only_the_minimal_skill_set_for_the_current_task"
  },
  "ecosystemActivation": {
    "intent": "Expose every available plugin, MCP server, connector, and skill through a governed activation hub without blanket live calls.",
    "defaultMode": "registry-first",
    "pluginCatalog": "content/development/plugin-capability-catalog.json",
    "routingOrder": [
      "task_intent",
      "repo_surface",
      "capability_family",
      "auth_and_target",
      "quality_gate",
      "live_action"
    ],
    "blockedByDefault": [
      "credentialed_writes",
      "blanket_oauth_calls",
      "broad_scans_without_scope",
      "unreviewed_remote_mutations",
      "unbounded_browser_or_indexing_runs"
    ]
  },
  "connectors": [
    {
      "id": "github",
      "surface": "repository",
      "status": "ready-if-authenticated",
      "activationPolicy": "bounded-preflight-before-push",
      "blockedWithout": ["clean_worktree", "publish_readiness_pass", "github_auth"],
      "qualityCommands": ["npm run automation:publish-readiness"]
    },
    {
      "id": "vercel",
      "surface": "cloud-deploy",
      "status": "candidate",
      "activationPolicy": "requires_provider_token_and_site_selection",
      "blockedWithout": ["provider_token", "site_selection", "SEIS_SITE_URL"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "cloudflare",
      "surface": "edge-deploy",
      "status": "candidate",
      "activationPolicy": "requires_provider_token_and_route_selection",
      "blockedWithout": ["provider_token", "route_selection", "SEIS_SITE_URL"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "netlify",
      "surface": "static-deploy",
      "status": "candidate",
      "activationPolicy": "requires_provider_token_and_site_selection",
      "blockedWithout": ["provider_token", "site_selection", "SEIS_SITE_URL"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "sentry",
      "surface": "observability",
      "status": "candidate",
      "activationPolicy": "quiet_error_signal_only_after_project_selection",
      "blockedWithout": ["project_selection", "auth_scope"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "slack",
      "surface": "release-notifications",
      "status": "candidate",
      "activationPolicy": "notify_only_after_user_approval",
      "blockedWithout": ["user_approval", "channel_scope"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "google-drive",
      "surface": "handoff-archive",
      "status": "candidate",
      "activationPolicy": "archive_only_after_user_approval",
      "blockedWithout": ["user_approval", "destination_selection"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "output-ai",
      "surface": "durable-workflow",
      "status": "candidate",
      "activationPolicy": "use_for_new_outputai_workflows_only",
      "blockedWithout": ["workflow_scope", "outputai_task_fit"],
      "qualityCommands": ["npm run check:cloud-environment"]
    },
    {
      "id": "public-equity-investing",
      "surface": "public-equity-research",
      "status": "requested-blocked",
      "activationPolicy": "only_after_exact_plugin_or_authenticated_financial_provider_is_available",
      "blockedWithout": ["public_equity_plugin_available", "financial_data_auth", "target_company_scope", "user_approval"],
      "qualityCommands": ["npm run check:requested-plugin-trace"]
    },
    {
      "id": "product-design",
      "surface": "product-design-strategy",
      "status": "requested-blocked",
      "activationPolicy": "only_after_exact_plugin_or_authenticated_design_surface_is_available",
      "blockedWithout": ["product_design_plugin_available", "product_design_auth", "product_design_scope", "user_approval"],
      "qualityCommands": ["npm run check:requested-plugin-trace"]
    },
    {
      "id": "investment-banking",
      "surface": "investment-banking-analysis",
      "status": "requested-blocked",
      "activationPolicy": "only_after_exact_plugin_or_authenticated_deal_data_provider_is_available",
      "blockedWithout": ["investment_banking_plugin_available", "investment_banking_auth", "deal_scope", "user_approval"],
      "qualityCommands": ["npm run check:requested-plugin-trace"]
    },
    {
      "id": "figma",
      "surface": "design-handoff",
      "status": "candidate",
      "activationPolicy": "read_design_context_only_after_file_or_node_is_explicit",
      "blockedWithout": ["figma_file_or_node", "user_approval", "design_scope"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "browser",
      "surface": "local-ui-validation",
      "status": "candidate",
      "activationPolicy": "use_for_known_local_or_file_url_smoke_checks_only",
      "blockedWithout": ["known_local_url_or_file", "ui_change_scope", "low_power_browser_budget"],
      "qualityCommands": ["npm run check:release-sync"]
    },
    {
      "id": "playwright",
      "surface": "e2e-render-validation",
      "status": "candidate",
      "activationPolicy": "run_only_for_ui_or_canvas_behavior_changes",
      "blockedWithout": ["ui_or_canvas_change", "test_target_url", "browser_budget"],
      "qualityCommands": ["npm run check:mobile-ergonomics"]
    },
    {
      "id": "semgrep",
      "surface": "static-security-review",
      "status": "candidate",
      "activationPolicy": "run_for_security_sensitive_code_paths_without_autofix",
      "blockedWithout": ["security_sensitive_change", "scan_scope", "no_autofix_confirmation"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "linear",
      "surface": "issue-planning",
      "status": "candidate",
      "activationPolicy": "create_or_update_issues_only_after_user_confirms_destination",
      "blockedWithout": ["workspace_auth", "project_destination", "user_approval"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "notion",
      "surface": "knowledge-base-handoff",
      "status": "candidate",
      "activationPolicy": "write_docs_only_after_workspace_and_page_are_confirmed",
      "blockedWithout": ["workspace_auth", "page_destination", "user_approval"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "google-drive-artifact-archive",
      "surface": "artifact-archive",
      "status": "candidate",
      "activationPolicy": "archive_release_artifacts_only_after_user_approval",
      "blockedWithout": ["drive_auth", "folder_destination", "user_approval"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "plugin-capability-router",
      "surface": "plugin-orchestration",
      "status": "registry-ready",
      "activationPolicy": "select_plugin_by_task_family_from_plugin_catalog_then_request_auth_or_install_only_if_needed",
      "blockedWithout": ["task_scope", "plugin_target", "user_approval"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "mcp-tool-router",
      "surface": "mcp-orchestration",
      "status": "registry-ready",
      "activationPolicy": "discover_mcp_tools_for_the_task_then_call_the_smallest_safe_tool_set",
      "blockedWithout": ["task_scope", "mcp_target", "write_scope"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    },
    {
      "id": "skill-router",
      "surface": "skill-orchestration",
      "status": "registry-ready",
      "activationPolicy": "load_only_named_or_task_matched_skills_and_keep_context_small",
      "blockedWithout": ["task_scope", "skill_target"],
      "qualityCommands": ["npm run check:aggressive-capability-map"]
    }
  ],
  "skills": [
    "42crunch-api-security-testing",
    "Adobe Acrobat",
    "Adobe Express",
    "Adobe Photoshop",
