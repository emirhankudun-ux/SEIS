  ],
  "capabilityFamilies": [
    {
      "id": "repo-governance",
      "includes": ["GitHub", "CodeRabbit", "Linear", "Notion"],
      "defaultAction": "read_status_then_plan",
      "liveWriteGate": "user_approval"
    },
    {
      "id": "design-ui-ux",
      "includes": ["Figma", "Canva", "Adobe Express", "Adobe Photoshop", "frontend-design", "Browser", "Playwright"],
      "defaultAction": "inspect_or_validate_known_target",
      "liveWriteGate": "explicit_design_target"
    },
    {
      "id": "cloud-deploy-observability",
      "includes": ["Vercel", "Cloudflare", "Netlify", "Supabase", "Sentry", "Datadog"],
      "defaultAction": "preflight_only",
      "liveWriteGate": "provider_token_and_rollback_owner"
    },
    {
      "id": "knowledge-handoff",
      "includes": ["Google Drive", "Gmail", "Google Calendar", "Slack", "Documents", "Spreadsheets", "Presentations"],
      "defaultAction": "draft_local_artifact",
      "liveWriteGate": "destination_and_audience"
    },
    {
      "id": "security-quality",
      "includes": ["Semgrep", "SonarQube", "Aikido", "42crunch-api-security-testing"],
      "defaultAction": "scoped_static_review",
      "liveWriteGate": "scan_scope"
    },
    {
      "id": "market-research-and-seo",
      "includes": ["Semrush", "Conductor", "Quartr", "Web search"],
      "defaultAction": "official_or_primary_source_lookup",
      "liveWriteGate": "research_question"
    },
    {
      "id": "agent-skill-development",
      "includes": ["OpenAI Developers", "plugin-creator", "skill-creator", "skill-installer", "MCP server dev"],
      "defaultAction": "local_spec_or_registry_update",
      "liveWriteGate": "target_runtime"
    }
  ],
  "automationRules": [
    "Use one connector only when it directly advances the requested task.",
    "Treat requests to use every plugin, MCP server, and skill as activation-hub work, not blanket live execution.",
    "Run local contract checks before any remote connector action.",
    "Stop before credentialed deployment if provider secrets or target URL are missing.",
    "Report connector status separately from source quality."
  ]
}
