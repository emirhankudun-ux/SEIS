set(SEIS_PACKAGE_PATH "dist/seis-static.zip")
set(SEIS_LIVE_UPLOAD_REQUIRES_TARGET TRUE)
set(SEIS_REDUCED_MOTION_REQUIRED TRUE)

function(seis_can_upload TARGET_CONFIRMED CHECKSUM_MATCHED OUT_VAR)
  if(${TARGET_CONFIRMED} AND ${CHECKSUM_MATCHED})
    set(${OUT_VAR} TRUE PARENT_SCOPE)
  else()
    set(${OUT_VAR} FALSE PARENT_SCOPE)
  endif()
endfunction()
