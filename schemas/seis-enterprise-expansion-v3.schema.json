{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/seis-enterprise-expansion-v3.schema.json",
  "title": "SEIS Enterprise Expansion V3 Registry",
  "description": "Public-safe registry for the SEIS architecture, execution, validation, observability, design, AI, knowledge, and long-term evolution governance surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "maturity",
    "project",
    "related_goal_id",
    "owner",
    "security_classification",
    "privacy_impact",
    "source_of_truth",
    "registry_path",
    "schema_path",
    "documentation_path",
    "stewardship_documentation_path",
    "validation_command",
    "lifecycle_states",
    "principles",
    "domains",
    "universal_node_contract",
    "requested_plugin_references",
    "final_enterprise_rule",
    "ten_year_stewardship",
    "implementation_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "seis-enterprise-expansion-v3"},
    "title": {"const": "SEIS Enterprise Expansion V3"},
    "status": {"enum": ["active", "proposed", "blocked", "deprecated"]},
    "maturity": {"enum": ["specification", "prototype", "experimental", "stable", "deprecated"]},
    "project": {"const": "seis"},
    "related_goal_id": {"pattern": "^SEIS-GOAL-[0-9]{3,}$"},
    "owner": {"type": "string", "minLength": 3},
    "security_classification": {"enum": ["public-safe", "restricted", "private"]},
    "privacy_impact": {"type": "string", "minLength": 1},
    "source_of_truth": {"type": "string", "minLength": 3},
    "registry_path": {"$ref": "#/$defs/repoPath"},
    "schema_path": {"$ref": "#/$defs/repoPath"},
    "documentation_path": {"$ref": "#/$defs/repoPath"},
    "stewardship_documentation_path": {"$ref": "#/$defs/repoPath"},
    "validation_command": {"type": "string", "minLength": 3},
    "lifecycle_states": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["specified", "planned", "active", "blocked", "completed", "unavailable", "deprecated"]}
    },
    "principles": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 3}},
    "domains": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/domain"}
    },
    "universal_node_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "completion_rule"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "completion_rule": {"type": "string", "minLength": 20}
      }
    },
    "requested_plugin_references": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "runtime_status", "write_access"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "status": {"const": "requested"},
          "runtime_status": {"const": "unverified"},
          "write_access": {"const": "not-granted"}
        }
      }
    },
    "final_enterprise_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_strengths", "prohibited_optimization", "long_term_rule"],
      "properties": {
        "required_strengths": {
          "type": "array",
          "const": ["Architecture", "Knowledge", "Security", "Maintainability", "Accessibility", "Performance", "Human Experience", "Long-Term Sustainability"]
        },
        "prohibited_optimization": {"const": "Never optimize only for the current iteration."},
        "long_term_rule": {"const": "Always optimize for the long-term evolution of the SEIS ecosystem."}
      }
    },
    "ten_year_stewardship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "anchor_date",
        "target_date",
        "target_horizon_years",
        "continuation_mode",
        "background_execution_claim",
        "required_review_cadences",
        "continuation_protocol",
        "annual_phases",
        "stewardship_metrics"
      ],
      "properties": {
        "status": {"const": "planned"},
        "anchor_date": {"type": "string", "format": "date"},
        "target_date": {"type": "string", "format": "date"},
        "target_horizon_years": {"const": 10},
        "continuation_mode": {"const": "session-based-continuation"},
        "background_execution_claim": {"const": false},
        "required_review_cadences": {
          "type": "array",
          "const": ["daily", "weekly", "monthly", "quarterly", "annual"]
        },
        "continuation_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_session", "during_session", "after_session", "required_state", "stop_conditions", "continuation_command"],
          "properties": {
            "before_session": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 10}},
            "during_session": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 10}},
            "after_session": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 10}},
            "required_state": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
            "stop_conditions": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 10}},
            "continuation_command": {"type": "string", "minLength": 40}
          }
        },
        "annual_phases": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/annualPhase"}
        },
        "stewardship_metrics": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stewardshipMetric"}
        }
      }
    },
    "implementation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_status_means", "not_claimed"],
      "properties": {
        "registry_status_means": {"type": "string", "minLength": 20},
        "not_claimed": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 3}}
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 2},
        "status": {"enum": ["specified", "planned", "active", "blocked", "completed", "unavailable", "deprecated"]}
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "terms", "required_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 3},
        "status": {"enum": ["specified", "planned", "active", "blocked", "completed", "unavailable", "deprecated"]},
        "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/term"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "node_required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "horizons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "forecasts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      }
    },
    "annualPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "year", "title", "status", "focus", "required_evidence", "exit_criteria", "review_cadence"],
      "properties": {
        "id": {"type": "string", "pattern": "^SEIS-10Y-Y(?:0[1-9]|10)$"},
        "year": {"type": "integer", "minimum": 1, "maximum": 10},
        "title": {"type": "string", "minLength": 3},
        "status": {"const": "planned"},
        "focus": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "exit_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "review_cadence": {"const": "annual"}
      }
    },
    "stewardshipMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "direction", "evidence_source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 3},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["increase", "decrease", "stable"]},
        "evidence_source": {"type": "string", "minLength": 3}
      }
    }
  }
}
