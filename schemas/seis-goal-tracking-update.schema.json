{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/seis-goal-tracking-update.schema.json",
  "title": "SEIS Goal Tracking Update Proposal",
  "description": "Public-safe proposal emitted by the Goal Tracking Update Orchestrator before a canonical goal record is changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "update_id",
    "goal_id",
    "requested_by",
    "owner_role",
    "change_reason",
    "scope",
    "non_goals",
    "affected_paths",
    "current_status",
    "proposed_status",
    "status_reason",
    "evidence_links",
    "validation_commands",
    "validation_results",
    "blockers",
    "risks",
    "rollback_plan",
    "affected_source_records",
    "generated_outputs",
    "approval_required",
    "next_action",
    "worktree_state",
    "failed_or_skipped_checks"
  ],
  "properties": {
    "$schema": {
      "const": "https://seis.dev/schemas/seis-goal-tracking-update.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "update_id": {
      "type": "string",
      "pattern": "^SEIS-UPDATE-[0-9]{3,}$"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^SEIS-GOAL-[0-9]{3,}$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 3
    },
    "owner_role": {
      "type": "string",
      "minLength": 3
    },
    "change_reason": {
      "type": "string",
      "minLength": 12
    },
    "scope": {
      "type": "string",
      "minLength": 12
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "current_status": {
      "$ref": "#/$defs/goalStatus"
    },
    "proposed_status": {
      "$ref": "#/$defs/goalStatus"
    },
    "status_reason": {
      "type": "string",
      "minLength": 12
    },
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "scope"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": ["passed", "failed", "skipped", "blocked", "not-run"]
          },
          "scope": {
            "type": "string",
            "minLength": 3
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 12
    },
    "affected_source_records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "generated_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string",
      "minLength": 12
    },
    "worktree_state": {
      "enum": ["clean", "dirty", "blocked", "not verified"]
    },
    "failed_or_skipped_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "$defs": {
    "goalStatus": {
      "enum": ["idea", "proposed", "planned", "active", "blocked", "in-review", "validated", "completed", "deferred", "archived", "deprecated"]
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
