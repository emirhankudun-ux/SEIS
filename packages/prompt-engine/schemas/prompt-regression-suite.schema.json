{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/prompt-regression-suite.schema.json",
  "title": "SEIS Prompt Regression Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "sourceDocuments",
    "suiteRules",
    "fixtures"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["draft", "fixture-backed", "blocked"]
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "suiteRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataPolicy",
        "executionMode",
        "nonClaims",
        "approvalRules"
      ],
      "properties": {
        "dataPolicy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "executionMode": {
          "enum": ["fixture-only", "local-only", "provider-backed"]
        },
        "nonClaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approvalRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/"
    },
    "assistantSurface": {
      "enum": [
        "repository-assistant",
        "documentation-assistant",
        "architecture-reviewer",
        "security-reviewer",
        "pr-reviewer",
        "roadmap-assistant",
        "research-assistant"
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assistantSurface",
        "promptVersionId",
        "purpose",
        "syntheticUserInput",
        "allowedContext",
        "forbiddenContext",
        "expectedOutputFields",
        "blockedScenarios",
        "approvalTriggers",
        "evidenceRequired",
        "auditMetadata",
        "sourceDocument",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "assistantSurface": {
          "$ref": "#/$defs/assistantSurface"
        },
        "promptVersionId": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "type": "string"
        },
        "syntheticUserInput": {
          "type": "string"
        },
        "allowedContext": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbiddenContext": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expectedOutputFields": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "blockedScenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approvalTriggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "auditMetadata": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sourceDocument": {
          "$ref": "#/$defs/repoPath"
        },
        "status": {
          "enum": ["draft", "fixture-backed", "blocked"]
        }
      }
    }
  }
}
