{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/agent-runtime-task-lifecycle.schema.json",
  "title": "SEIS Agent Runtime Task Lifecycle Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "sourceDocuments",
    "lifecycleStates",
    "approvalStates",
    "runs",
    "nonClaims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["fixture-backed", "blocked"]
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "lifecycleStates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "enum": [
          "planned",
          "ready",
          "running",
          "approval-needed",
          "blocked",
          "failed",
          "validated"
        ]
      },
      "uniqueItems": true
    },
    "approvalStates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "enum": [
          "not-required",
          "approval-needed",
          "approved",
          "denied",
          "blocked"
        ]
      },
      "uniqueItems": true
    },
    "runs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/|^SECURITY\\.md$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agentId",
        "agentRole",
        "taskType",
        "lifecycleState",
        "approvalState",
        "inputContext",
        "allowedActions",
        "forbiddenActions",
        "approvalGates",
        "delegationPolicy",
        "executionBudget",
        "escalationPath",
        "expectedOutputs",
        "validation",
        "auditMetadata",
        "sourceLinks",
        "status",
        "maturity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "agentId": {
          "$ref": "#/$defs/id"
        },
        "agentRole": {
          "enum": [
            "Architect Agent",
            "Security Agent",
            "Documentation Agent",
            "Repository Intelligence Agent",
            "Command Center Operator",
            "AI Systems Agent",
            "Agent Runtime Agent",
            "Product Agent",
            "QA and Evaluation Agent",
            "UX and Design System Agent",
            "Research Agent",
            "Knowledge Agent",
            "DevOps Agent"
          ]
        },
        "taskType": {
          "enum": [
            "documentation-review",
            "repository-assistance",
            "ai-operating-model-review",
            "agent-runtime-governance",
            "external-provider-routing",
            "ssh-deployment-review"
          ]
        },
        "lifecycleState": {
          "enum": [
            "planned",
            "ready",
            "running",
            "approval-needed",
            "blocked",
            "failed",
            "validated"
          ]
        },
        "approvalState": {
          "enum": [
            "not-required",
            "approval-needed",
            "approved",
            "denied",
            "blocked"
          ]
        },
        "inputContext": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbiddenActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approvalGates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delegationPolicy": {
          "$ref": "#/$defs/delegationPolicy"
        },
        "executionBudget": {
          "$ref": "#/$defs/executionBudget"
        },
        "escalationPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expectedOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "auditMetadata": {
          "$ref": "#/$defs/auditMetadata"
        },
        "sourceLinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "status": {
          "enum": [
            "planned",
            "ready",
            "running",
            "approval-needed",
            "blocked",
            "failed",
            "validated"
          ]
        },
        "maturity": {
          "enum": ["fixture-backed", "local-alpha", "draft", "blocked"]
        }
      }
    },
    "delegationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spawnPolicy",
        "parentRunId",
        "delegationDepth",
        "maxDelegationDepth",
        "childAgentLimit",
        "requiresHandoff"
      ],
      "properties": {
        "spawnPolicy": {
          "enum": ["none", "read-only-parallel", "bounded-tree", "blocked"]
        },
        "parentRunId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "delegationDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxDelegationDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "childAgentLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "requiresHandoff": {
          "type": "boolean"
        }
      }
    },
    "executionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepBudget",
        "timeBudgetMinutes",
        "costBudgetMode",
        "contextBudgetMode"
      ],
      "properties": {
        "stepBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "timeBudgetMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "costBudgetMode": {
          "enum": ["none", "metadata-only", "approval-needed"]
        },
        "contextBudgetMode": {
          "enum": ["bounded", "metadata-only", "approval-needed"]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence", "notes"],
      "properties": {
        "result": {
          "enum": ["pass", "blocked", "unknown"]
        },
        "evidence": {
          "$ref": "#/$defs/repoPath"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redactionState",
        "toolCallsPerformed",
        "writesPerformed",
        "externalProviderCalled",
        "privilegedOperationPerformed",
        "safeMetadata"
      ],
      "properties": {
        "redactionState": {
          "enum": ["metadata-only", "redacted", "not-sensitive"]
        },
        "toolCallsPerformed": {
          "const": false
        },
        "writesPerformed": {
          "const": false
        },
        "externalProviderCalled": {
          "const": false
        },
        "privilegedOperationPerformed": {
          "const": false
        },
        "safeMetadata": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
