{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/ai/model-evaluation-report.schema.json",
  "title": "SEIS Model Evaluation Report",
  "description": "Capability, safety, contamination, and independent-review record for a run or checkpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "schemaVersion",
    "recordType",
    "id",
    "recordStatus",
    "fixtureOnly",
    "recordHash",
    "previousRecordHash",
    "trainingRunId",
    "checkpointId",
    "benchmarkExecuted",
    "codeCommit",
    "configHash",
    "randomSeeds",
    "hardwareProfile",
    "runtimeVersion",
    "datasetManifestIds",
    "metrics",
    "safetyCriticalFailureCount",
    "contaminationStatus",
    "independentReviewStatus",
    "reportUri",
    "reportHash",
    "rawOutputUri",
    "rawOutputHash",
    "createdAt",
    "truthBoundary"
  ],
  "properties": {
    "schemaRef": {
      "const": "packages/evals/schemas/model-evaluation-report.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "evaluation-report"
    },
    "id": {
      "type": "string",
      "pattern": "^evaluation:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "recordStatus": {
      "enum": [
        "fixture-only-not-evidence",
        "not-run",
        "running",
        "completed",
        "failed",
        "withdrawn"
      ]
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "recordHash": {
      "$ref": "#/$defs/hash"
    },
    "previousRecordHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "trainingRunId": {
      "type": "string",
      "pattern": "^training-run:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "checkpointId": {
      "type": ["string", "null"],
      "pattern": "^checkpoint:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "benchmarkExecuted": {
      "type": "boolean"
    },
    "codeCommit": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{40}$"
    },
    "configHash": {
      "$ref": "#/$defs/hash"
    },
    "randomSeeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "hardwareProfile": {
      "type": "string",
      "minLength": 3
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 3
    },
    "datasetManifestIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^dataset:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
      }
    },
    "metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "direction", "threshold", "passed"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": ["higher-is-better", "lower-is-better", "exact"]
          },
          "threshold": {
            "type": "number"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "safetyCriticalFailureCount": {
      "type": "integer",
      "minimum": 0
    },
    "contaminationStatus": {
      "enum": ["not-run", "passed", "failed", "unknown"]
    },
    "independentReviewStatus": {
      "enum": ["not-reviewed", "accepted", "rejected"]
    },
    "reportUri": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "reportHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "rawOutputUri": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "rawOutputHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "createdAt": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "truthBoundary": {
      "type": "string",
      "minLength": 24
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableTimestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    }
  }
}
