{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/ai/checkpoint-record.schema.json",
  "title": "SEIS Checkpoint Record",
  "description": "Immutable checkpoint lifecycle record. A not-created fixture must never be treated as a model artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "schemaVersion",
    "recordType",
    "id",
    "recordStatus",
    "fixtureOnly",
    "recordHash",
    "previousRecordHash",
    "trainingRunId",
    "modelClass",
    "architectureId",
    "tokenizerId",
    "datasetManifestId",
    "dependencyLockHash",
    "containerImageDigest",
    "hardwareProfile",
    "runtimeVersion",
    "verificationStatus",
    "safetyReviewStatus",
    "privacyReviewStatus",
    "modelCard",
    "step",
    "artifactExists",
    "artifactUri",
    "artifactHash",
    "parentCheckpointId",
    "createdAt",
    "evaluationReportIds",
    "published",
    "routeEligible",
    "truthBoundary"
  ],
  "properties": {
    "schemaRef": {
      "const": "packages/evals/schemas/checkpoint-record.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "checkpoint-record"
    },
    "id": {
      "type": "string",
      "pattern": "^checkpoint:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "recordStatus": {
      "enum": [
        "fixture-only-not-evidence",
        "staged",
        "accepted",
        "quarantined",
        "rejected",
        "withdrawn"
      ]
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "recordHash": {
      "$ref": "#/$defs/hash"
    },
    "previousRecordHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "trainingRunId": {
      "type": "string",
      "pattern": "^training-run:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "modelClass": {
      "enum": ["seed", "small", "20B", "70B", "150B", "300B+", "512B"]
    },
    "architectureId": {
      "type": "string",
      "minLength": 3
    },
    "tokenizerId": {
      "type": "string",
      "minLength": 3
    },
    "datasetManifestId": {
      "type": "string",
      "pattern": "^dataset:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "dependencyLockHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "containerImageDigest": {
      "$ref": "#/$defs/nullableHash"
    },
    "hardwareProfile": {
      "type": "string",
      "minLength": 3
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 3
    },
    "verificationStatus": {
      "enum": ["not-run", "passed", "failed"]
    },
    "safetyReviewStatus": {
      "enum": ["not-reviewed", "accepted", "rejected"]
    },
    "privacyReviewStatus": {
      "enum": ["not-reviewed", "accepted", "rejected"]
    },
    "modelCard": {
      "$ref": "#/$defs/modelCardReference"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "artifactExists": {
      "type": "boolean"
    },
    "artifactUri": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "artifactHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "parentCheckpointId": {
      "type": ["string", "null"],
      "pattern": "^checkpoint:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "createdAt": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "evaluationReportIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evaluation:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
      }
    },
    "published": {
      "type": "boolean"
    },
    "routeEligible": {
      "type": "boolean"
    },
    "truthBoundary": {
      "type": "string",
      "minLength": 24
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableTimestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "modelCardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentHash", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^model-card:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
        },
        "contentHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "status": {
          "enum": ["fixture-only-not-evidence", "draft", "accepted", "rejected", "withdrawn"]
        }
      }
    }
  }
}
