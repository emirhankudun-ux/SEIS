{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/local-readonly-repository-assistant.schema.json",
  "title": "SEIS Local Read-Only Repository Assistant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "mode",
    "readOnly",
    "externalProviderRouting",
    "sourceDocuments",
    "allowedCommands",
    "forbiddenActions",
    "assistantOutput",
    "auditMetadata",
    "nonClaims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["draft", "local-alpha", "blocked"]
    },
    "mode": {
      "enum": ["local-only"]
    },
    "readOnly": {
      "const": true
    },
    "externalProviderRouting": {
      "const": false
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "allowedCommands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "forbiddenActions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "assistantOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryCondition",
        "evidence",
        "risks",
        "validationStatus",
        "recommendedBranchPlan",
        "excludedMaterial",
        "nextSafeAction"
      ],
      "properties": {
        "repositoryCondition": {
          "$ref": "#/$defs/outputBlock"
        },
        "evidence": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outputBlock"
          }
        },
        "validationStatus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validationItem"
          }
        },
        "recommendedBranchPlan": {
          "$ref": "#/$defs/outputBlock"
        },
        "excludedMaterial": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "nextSafeAction": {
          "$ref": "#/$defs/outputBlock"
        }
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacyMode",
        "providerProfile",
        "writesPerformed",
        "approvalState",
        "redactionState",
        "sourceLinkMode"
      ],
      "properties": {
        "privacyMode": {
          "enum": ["local-only"]
        },
        "providerProfile": {
          "enum": ["none-local-prototype"]
        },
        "writesPerformed": {
          "const": false
        },
        "approvalState": {
          "enum": ["not-required"]
        },
        "redactionState": {
          "enum": ["metadata-and-paths-only"]
        },
        "sourceLinkMode": {
          "enum": ["relative-repository-paths"]
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/"
    },
    "outputBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "sourceLinks"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "sourceLinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "sourceLinks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["git-state", "doc", "package", "validation", "roadmap", "security"]
        },
        "summary": {
          "type": "string"
        },
        "sourceLinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        }
      }
    },
    "validationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status", "summary", "sourceLinks"],
      "properties": {
        "command": {
          "type": "string"
        },
        "status": {
          "enum": ["pass", "fail", "blocked", "not-run"]
        },
        "summary": {
          "type": "string"
        },
        "sourceLinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        }
      }
    }
  }
}
