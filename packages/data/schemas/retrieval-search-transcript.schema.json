{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/retrieval-search-transcript.schema.json",
  "title": "SEIS Local Retrieval Result Cards And No-Content Search Transcripts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "mode",
    "readOnly",
    "providerCallPerformed",
    "externalProviderRouting",
    "browserReceivesProviderKey",
    "storesRawContent",
    "rawContentReturned",
    "writesPersistentMemory",
    "createsEmbeddingIndex",
    "sourceDocuments",
    "retrievalResultCards",
    "noContentSearchTranscripts",
    "nonClaims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "const": "local-readonly-retrieval-search-transcript"
    },
    "status": {
      "const": "fixture-backed"
    },
    "mode": {
      "const": "local-only"
    },
    "readOnly": {
      "const": true
    },
    "providerCallPerformed": {
      "const": false
    },
    "externalProviderRouting": {
      "const": false
    },
    "browserReceivesProviderKey": {
      "const": false
    },
    "storesRawContent": {
      "const": false
    },
    "rawContentReturned": {
      "const": false
    },
    "writesPersistentMemory": {
      "const": false
    },
    "createsEmbeddingIndex": {
      "const": false
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceLink"
      },
      "uniqueItems": true
    },
    "retrievalResultCards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalResultCard"
      }
    },
    "noContentSearchTranscripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/noContentSearchTranscript"
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "evidenceLink": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/"
    },
    "sourceClass": {
      "enum": [
        "official",
        "review",
        "archive",
        "mock",
        "scan-generated",
        "live",
        "planned",
        "unknown"
      ]
    },
    "retrievalState": {
      "enum": [
        "approved",
        "pending-review",
        "local-only",
        "redacted",
        "restricted",
        "expired",
        "blocked"
      ]
    },
    "privacyMode": {
      "enum": ["local-only", "metadata-only", "disabled"]
    },
    "freshness": {
      "enum": ["current", "needs-review", "stale", "unknown"]
    },
    "retrievalResultCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterId",
        "sourceId",
        "sourceName",
        "sourceClass",
        "retrievalState",
        "privacyMode",
        "freshness",
        "summary",
        "providerCallPerformed",
        "externalProviderRouting",
        "storesRawContent",
        "rawContentReturned",
        "writesPersistentMemory",
        "createsEmbeddingIndex",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "adapterId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceName": { "type": "string" },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "retrievalState": { "$ref": "#/$defs/retrievalState" },
        "privacyMode": { "$ref": "#/$defs/privacyMode" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "summary": { "type": "string" },
        "providerCallPerformed": { "const": false },
        "externalProviderRouting": { "const": false },
        "storesRawContent": { "const": false },
        "rawContentReturned": { "const": false },
        "writesPersistentMemory": { "const": false },
        "createsEmbeddingIndex": { "const": false },
        "status": { "enum": ["validated", "blocked"] },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "noContentSearchTranscript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query",
        "adapterId",
        "resultCount",
        "emptyState",
        "blockedSources",
        "providerCallPerformed",
        "externalProviderRouting",
        "storesRawContent",
        "rawContentReturned",
        "writesPersistentMemory",
        "createsEmbeddingIndex",
        "decisionState",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "query": { "type": "string" },
        "adapterId": { "$ref": "#/$defs/id" },
        "resultCount": { "const": 0 },
        "emptyState": { "type": "string" },
        "blockedSources": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "providerCallPerformed": { "const": false },
        "externalProviderRouting": { "const": false },
        "storesRawContent": { "const": false },
        "rawContentReturned": { "const": false },
        "writesPersistentMemory": { "const": false },
        "createsEmbeddingIndex": { "const": false },
        "decisionState": { "enum": ["empty", "blocked"] },
        "status": { "enum": ["validated", "blocked"] },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    }
  }
}
