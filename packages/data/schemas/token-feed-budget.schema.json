{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/token-feed-budget.schema.json",
  "title": "SEIS Token Feed Budget Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "sourceDocuments",
    "targetTokenBudget",
    "tokensExecuted",
    "budgetMode",
    "privacyMode",
    "feedState",
    "allocations",
    "integrationTargets",
    "gateRules",
    "auditMetadata",
    "nonClaims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["fixture-backed", "blocked"]
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "targetTokenBudget": {
      "type": "integer",
      "const": 10000000
    },
    "tokensExecuted": {
      "type": "integer",
      "const": 0
    },
    "budgetMode": {
      "enum": ["metadata-only-feed-plan"]
    },
    "privacyMode": {
      "enum": ["metadata-only"]
    },
    "feedState": {
      "enum": ["planned", "validated", "blocked"]
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "integrationTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRouterRouteId",
        "knowledgeSourceId",
        "agentTaskId",
        "sharedContractFixture",
        "commandCenterProjection"
      ],
      "properties": {
        "modelRouterRouteId": {
          "$ref": "#/$defs/id"
        },
        "knowledgeSourceId": {
          "$ref": "#/$defs/id"
        },
        "agentTaskId": {
          "$ref": "#/$defs/id"
        },
        "sharedContractFixture": {
          "$ref": "#/$defs/repoPath"
        },
        "commandCenterProjection": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "gateRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redactionState",
        "rawContentStored",
        "embeddingIndexCreated",
        "persistentMemoryWritePerformed",
        "providerCallPerformed",
        "modelTrainingPerformed",
        "browserReceivesProviderKey",
        "safeMetadata"
      ],
      "properties": {
        "redactionState": {
          "enum": ["metadata-only"]
        },
        "rawContentStored": {
          "const": false
        },
        "embeddingIndexCreated": {
          "const": false
        },
        "persistentMemoryWritePerformed": {
          "const": false
        },
        "providerCallPerformed": {
          "const": false
        },
        "modelTrainingPerformed": {
          "const": false
        },
        "browserReceivesProviderKey": {
          "const": false
        },
        "safeMetadata": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/"
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceClass",
        "retrievalState",
        "privacyMode",
        "plannedTokens",
        "approvedUse",
        "evidence",
        "storesRawContent",
        "externalRoutingAllowed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceClass": {
          "enum": ["official", "scan-generated", "mock", "archive", "planned"]
        },
        "retrievalState": {
          "enum": ["approved", "local-only", "blocked"]
        },
        "privacyMode": {
          "enum": ["metadata-only", "disabled"]
        },
        "plannedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "approvedUse": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/repoPath"
        },
        "storesRawContent": {
          "type": "boolean"
        },
        "externalRoutingAllowed": {
          "type": "boolean"
        }
      }
    }
  }
}
