{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/retrieval-query-adapter.schema.json",
  "title": "SEIS Local Read-Only Retrieval Query Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "mode",
    "readOnly",
    "externalProviderRouting",
    "providerCallPerformed",
    "browserReceivesProviderKey",
    "secretMaterialStored",
    "storesRawContent",
    "writesPersistentMemory",
    "createsEmbeddingIndex",
    "sourceDocuments",
    "queryIntents",
    "allowedSourceClasses",
    "forbiddenSourceClasses",
    "allowedRetrievalStates",
    "blockedRetrievalStates",
    "queryAdapters",
    "auditMetadata",
    "nonClaims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "const": "local-readonly-retrieval-query-adapter"
    },
    "status": {
      "const": "fixture-backed"
    },
    "mode": {
      "const": "local-only"
    },
    "readOnly": {
      "const": true
    },
    "externalProviderRouting": {
      "const": false
    },
    "providerCallPerformed": {
      "const": false
    },
    "browserReceivesProviderKey": {
      "const": false
    },
    "secretMaterialStored": {
      "const": false
    },
    "storesRawContent": {
      "const": false
    },
    "writesPersistentMemory": {
      "const": false
    },
    "createsEmbeddingIndex": {
      "const": false
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceLink"
      },
      "uniqueItems": true
    },
    "queryIntents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/queryIntent"
      },
      "uniqueItems": true
    },
    "allowedSourceClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceClass"
      },
      "uniqueItems": true
    },
    "forbiddenSourceClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceClass"
      },
      "uniqueItems": true
    },
    "allowedRetrievalStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalState"
      },
      "uniqueItems": true
    },
    "blockedRetrievalStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalState"
      },
      "uniqueItems": true
    },
    "queryAdapters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/queryAdapter"
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewState", "evidence"],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "reviewState": {
          "enum": ["fixture-backed", "blocked", "needs-review"]
        },
        "evidence": {
          "$ref": "#/$defs/evidenceLink"
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "evidenceLink": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/"
    },
    "sourceClass": {
      "enum": [
        "official",
        "review",
        "archive",
        "mock",
        "scan-generated",
        "live",
        "planned",
        "unknown"
      ]
    },
    "retrievalState": {
      "enum": [
        "approved",
        "pending-review",
        "local-only",
        "redacted",
        "restricted",
        "expired",
        "blocked"
      ]
    },
    "queryIntent": {
      "enum": [
        "command-center-evidence-lookup",
        "documentation-metadata-summary",
        "validation-status-lookup",
        "blocked-archive-guard"
      ]
    },
    "queryAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterName",
        "queryIntent",
        "mode",
        "privacyMode",
        "readOnly",
        "providerCallPerformed",
        "externalProviderRouting",
        "browserReceivesProviderKey",
        "secretMaterialStored",
        "storesRawContent",
        "writesPersistentMemory",
        "createsEmbeddingIndex",
        "allowedKnowledgeSourceIds",
        "forbiddenKnowledgeSourceIds",
        "inputShape",
        "outputShape",
        "sourceSelectionPolicy",
        "rankingPolicy",
        "redactionPolicy",
        "freshnessPolicy",
        "resultLimit",
        "emptyState",
        "failureStates",
        "allowedActions",
        "forbiddenActions",
        "approvalState",
        "status",
        "maturity",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "adapterName": {
          "type": "string"
        },
        "queryIntent": {
          "$ref": "#/$defs/queryIntent"
        },
        "mode": {
          "enum": ["local-only", "disabled"]
        },
        "privacyMode": {
          "enum": ["local-only", "metadata-only", "disabled"]
        },
        "readOnly": {
          "const": true
        },
        "providerCallPerformed": {
          "const": false
        },
        "externalProviderRouting": {
          "const": false
        },
        "browserReceivesProviderKey": {
          "const": false
        },
        "secretMaterialStored": {
          "const": false
        },
        "storesRawContent": {
          "const": false
        },
        "writesPersistentMemory": {
          "const": false
        },
        "createsEmbeddingIndex": {
          "const": false
        },
        "allowedKnowledgeSourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "forbiddenKnowledgeSourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "inputShape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "outputShape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sourceSelectionPolicy": {
          "type": "string"
        },
        "rankingPolicy": {
          "type": "string"
        },
        "redactionPolicy": {
          "type": "string"
        },
        "freshnessPolicy": {
          "type": "string"
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "emptyState": {
          "type": "string"
        },
        "failureStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbiddenActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "approvalState": {
          "enum": ["not-required", "approval-needed", "approved", "denied", "blocked"]
        },
        "status": {
          "enum": ["validated", "blocked"]
        },
        "maturity": {
          "enum": ["fixture-backed", "blocked"]
        },
        "evidence": {
          "$ref": "#/$defs/evidenceLink"
        }
      }
    }
  }
}
