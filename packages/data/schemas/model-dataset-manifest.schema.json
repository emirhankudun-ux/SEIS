{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/ai/model-dataset-manifest.schema.json",
  "title": "SEIS Model Dataset Manifest",
  "description": "Strict provenance and readiness record for a dataset considered for SEIS model research. A valid manifest is not training authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "schemaVersion",
    "recordType",
    "id",
    "recordStatus",
    "fixtureOnly",
    "recordHash",
    "previousRecordHash",
    "version",
    "createdAt",
    "ownerRole",
    "datasetCard",
    "datasetReady",
    "provenanceStatus",
    "licenseStatus",
    "containsPrivateData",
    "sourceCount",
    "sources",
    "splits",
    "contaminationReview",
    "humanApproval",
    "truthBoundary"
  ],
  "properties": {
    "schemaRef": {
      "const": "packages/data/schemas/model-dataset-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "dataset-manifest"
    },
    "id": {
      "type": "string",
      "pattern": "^dataset:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "recordStatus": {
      "enum": ["fixture-only-not-evidence", "draft", "review", "accepted", "rejected", "withdrawn"]
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "recordHash": {
      "$ref": "#/$defs/hash"
    },
    "previousRecordHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "ownerRole": {
      "type": "string",
      "minLength": 3
    },
    "datasetCard": {
      "$ref": "#/$defs/datasetCardReference"
    },
    "datasetReady": {
      "type": "boolean"
    },
    "provenanceStatus": {
      "enum": ["not-reviewed", "accepted", "rejected"]
    },
    "licenseStatus": {
      "enum": ["not-reviewed", "accepted", "rejected"]
    },
    "containsPrivateData": {
      "type": "boolean"
    },
    "sourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceType",
          "uri",
          "license",
          "accessClass",
          "sha256",
          "approvedForTraining"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^source:[a-z0-9][a-z0-9._-]{2,}$"
          },
          "sourceType": {
            "enum": ["seis-owned", "licensed-public", "synthetic", "third-party"]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "accessClass": {
            "enum": ["public", "internal", "confidential", "prohibited"]
          },
          "sha256": {
            "$ref": "#/$defs/nullableHash"
          },
          "approvedForTraining": {
            "type": "boolean"
          }
        }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "dev", "test"],
      "properties": {
        "train": {
          "$ref": "#/$defs/split"
        },
        "dev": {
          "$ref": "#/$defs/split"
        },
        "test": {
          "$ref": "#/$defs/split"
        }
      }
    },
    "contaminationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reportPath", "reviewedAt"],
      "properties": {
        "status": {
          "enum": ["not-run", "passed", "failed"]
        },
        "reportPath": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "reviewedAt": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      }
    },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "approvalId"],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "enum": ["missing", "accepted", "rejected", "expired"]
        },
        "approvalId": {
          "$ref": "#/$defs/nullableApprovalId"
        }
      }
    },
    "truthBoundary": {
      "type": "string",
      "minLength": 24
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableTimestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "nullableRepoPath": {
      "type": ["string", "null"],
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nullableApprovalId": {
      "type": ["string", "null"],
      "pattern": "^approval:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "datasetCardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentHash", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dataset-card:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
        },
        "contentHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "status": {
          "enum": ["fixture-only-not-evidence", "draft", "accepted", "rejected", "withdrawn"]
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "manifestSha256"],
      "properties": {
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "manifestSha256": {
          "$ref": "#/$defs/nullableHash"
        }
      }
    }
  }
}
