{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/ai-core-app-contract.schema.json",
  "title": "SEIS AI Core and Command Center Shared Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "sourceDocuments",
    "stateVocabulary",
    "llmExecutionModes",
    "moduleMaturities",
    "modelRoutes",
    "promptVersions",
    "agentTasks",
    "toolRegistryEntries",
    "knowledgeSources",
    "retrievalQueryAdapters",
    "retrievalFilterControls",
    "retrievalEmptyStateTestCases",
    "retrievalResultCards",
    "noContentSearchTranscripts",
    "approvalRequests",
    "evaluationResults",
    "auditEvents",
    "repositoryFindings",
    "documentationStatuses",
    "securityFindings",
    "roadmapItems",
    "aiSurfaces",
    "repositoryIntelligence",
    "goalEvidenceGates",
    "goalTrackingStates"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["draft", "fixture-backed", "blocked"]
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceLink"
      }
    },
    "stateVocabulary": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/state"
      },
      "uniqueItems": true
    },
    "llmExecutionModes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/llmExecutionMode"
      },
      "uniqueItems": true
    },
    "moduleMaturities": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/moduleMaturity"
      },
      "uniqueItems": true
    },
    "modelRoutes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modelRoute"
      }
    },
    "promptVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/promptVersion"
      }
    },
    "agentTasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agentTask"
      }
    },
    "toolRegistryEntries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/toolRegistryEntry"
      }
    },
    "knowledgeSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/knowledgeSource"
      }
    },
    "retrievalQueryAdapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalQueryAdapter"
      }
    },
    "retrievalFilterControls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalFilterControl"
      }
    },
    "retrievalEmptyStateTestCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalEmptyStateTestCase"
      }
    },
    "retrievalResultCards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retrievalResultCard"
      }
    },
    "noContentSearchTranscripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/noContentSearchTranscript"
      }
    },
    "approvalRequests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/approvalRequest"
      }
    },
    "evaluationResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluationResult"
      }
    },
    "auditEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/auditEvent"
      }
    },
    "repositoryFindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryFinding"
      }
    },
    "documentationStatuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/documentationStatus"
      }
    },
    "securityFindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/securityFinding"
      }
    },
    "roadmapItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/roadmapItem"
      }
    },
    "aiSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/aiSurface"
      }
    },
    "repositoryIntelligence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryIntelligence"
      }
    },
    "goalEvidenceGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/goalEvidenceGate"
      }
    },
    "goalTrackingStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/goalTrackingState"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "state": {
      "enum": [
        "ready",
        "draft",
        "planned",
        "blocked",
        "approval-needed",
        "degraded",
        "unknown",
        "running",
        "failed",
        "validated"
      ]
    },
    "llmExecutionMode": {
      "enum": [
        "local-only",
        "local-preferred",
        "external-provider-allowed",
        "external-provider-redacted",
        "metadata-only",
        "offline",
        "disabled",
        "research-only"
      ]
    },
    "moduleMaturity": {
      "enum": [
        "planned",
        "draft",
        "fixture-backed",
        "local-alpha",
        "provider-alpha",
        "beta",
        "stable",
        "research-only",
        "blocked"
      ]
    },
    "sourceClass": {
      "enum": [
        "official",
        "review",
        "archive",
        "mock",
        "scan-generated",
        "live",
        "planned",
        "unknown"
      ]
    },
    "retrievalState": {
      "enum": [
        "approved",
        "pending-review",
        "local-only",
        "redacted",
        "restricted",
        "expired",
        "blocked"
      ]
    },
    "freshness": {
      "enum": ["current", "needs-review", "stale", "unknown"]
    },
    "evidenceLink": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/"
    },
    "modelRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taskType",
        "dataClass",
        "privacyMode",
        "providerProfile",
        "modelProfile",
        "promptVersionId",
        "approvalState",
        "evaluationProfile",
        "status",
        "maturity",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "taskType": { "type": "string" },
        "dataClass": {
          "enum": ["public", "repository", "sensitive", "secret", "research"]
        },
        "privacyMode": { "$ref": "#/$defs/llmExecutionMode" },
        "providerProfile": { "type": "string" },
        "modelProfile": { "type": "string" },
        "promptVersionId": { "$ref": "#/$defs/id" },
        "approvalState": {
          "enum": ["not-required", "approval-needed", "approved", "denied", "blocked"]
        },
        "blockedReason": { "type": "string" },
        "evaluationProfile": { "type": "string" },
        "status": { "$ref": "#/$defs/state" },
        "maturity": { "$ref": "#/$defs/moduleMaturity" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "promptVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "scope",
        "status",
        "maturity",
        "regressionSuite",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "scope": { "type": "string" },
        "status": { "$ref": "#/$defs/state" },
        "maturity": { "$ref": "#/$defs/moduleMaturity" },
        "regressionSuite": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "agentTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agentRole",
        "intent",
        "allowedActions",
        "forbiddenActions",
        "approvalState",
        "status",
        "maturity",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "agentRole": { "type": "string" },
        "intent": { "type": "string" },
        "allowedActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbiddenActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "approvalState": {
          "enum": ["not-required", "approval-needed", "approved", "denied", "blocked"]
        },
        "status": { "$ref": "#/$defs/state" },
        "maturity": { "$ref": "#/$defs/moduleMaturity" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "toolRegistryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "toolName",
        "surfaceType",
        "riskClass",
        "permissionState",
        "approvalState",
        "allowedActions",
        "forbiddenActions",
        "status",
        "maturity",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "toolName": { "type": "string" },
        "surfaceType": {
          "enum": [
            "cli-script",
            "mcp-tool",
            "plugin",
            "provider-api",
            "ssh-operation"
          ]
        },
        "riskClass": {
          "enum": [
            "read-only",
            "local-write",
            "external-read",
            "external-write",
            "privileged",
            "destructive"
          ]
        },
        "permissionState": {
          "enum": [
            "allowed",
            "scoped",
            "approval-needed",
            "blocked",
            "disabled"
          ]
        },
        "approvalState": {
          "enum": ["not-required", "approval-needed", "approved", "denied", "blocked"]
        },
        "allowedActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbiddenActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "status": { "$ref": "#/$defs/state" },
        "maturity": { "$ref": "#/$defs/moduleMaturity" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "knowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceName",
        "sourceClass",
        "retrievalState",
        "privacyMode",
        "freshness",
        "ingestionPolicy",
        "approvedUses",
        "forbiddenUses",
        "externalRoutingAllowed",
        "storesRawContent",
        "status",
        "maturity",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceName": { "type": "string" },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "retrievalState": { "$ref": "#/$defs/retrievalState" },
        "privacyMode": { "$ref": "#/$defs/llmExecutionMode" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "ingestionPolicy": {
          "enum": [
            "approved-metadata",
            "approved-content",
            "review-only",
            "blocked",
            "future"
          ]
        },
        "approvedUses": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbiddenUses": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "externalRoutingAllowed": { "type": "boolean" },
        "storesRawContent": { "type": "boolean" },
        "status": { "$ref": "#/$defs/state" },
        "maturity": { "$ref": "#/$defs/moduleMaturity" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "retrievalQueryAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterName",
        "queryIntent",
        "mode",
        "privacyMode",
        "readOnly",
        "providerCallPerformed",
        "externalProviderRouting",
        "browserReceivesProviderKey",
        "secretMaterialStored",
        "storesRawContent",
        "writesPersistentMemory",
        "createsEmbeddingIndex",
        "allowedKnowledgeSourceIds",
        "forbiddenKnowledgeSourceIds",
        "resultShape",
        "resultLimit",
        "approvalState",
        "allowedActions",
        "forbiddenActions",
        "status",
        "maturity",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "adapterName": { "type": "string" },
        "queryIntent": {
          "enum": [
            "command-center-evidence-lookup",
            "documentation-metadata-summary",
            "validation-status-lookup",
            "blocked-archive-guard"
          ]
        },
        "mode": { "enum": ["local-only", "disabled"] },
        "privacyMode": { "$ref": "#/$defs/llmExecutionMode" },
        "readOnly": { "type": "boolean" },
        "providerCallPerformed": { "type": "boolean" },
        "externalProviderRouting": { "type": "boolean" },
        "browserReceivesProviderKey": { "type": "boolean" },
        "secretMaterialStored": { "type": "boolean" },
        "storesRawContent": { "type": "boolean" },
        "writesPersistentMemory": { "type": "boolean" },
        "createsEmbeddingIndex": { "type": "boolean" },
        "allowedKnowledgeSourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "forbiddenKnowledgeSourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "resultShape": {
          "type": "string"
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "approvalState": {
          "enum": ["not-required", "approval-needed", "approved", "denied", "blocked"]
        },
        "allowedActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "forbiddenActions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "status": { "$ref": "#/$defs/state" },
        "maturity": { "$ref": "#/$defs/moduleMaturity" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "retrievalResultCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterId",
        "sourceId",
        "sourceName",
        "sourceClass",
        "retrievalState",
        "privacyMode",
        "freshness",
        "summary",
        "providerCallPerformed",
        "externalProviderRouting",
        "storesRawContent",
        "rawContentReturned",
        "writesPersistentMemory",
        "createsEmbeddingIndex",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "adapterId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceName": { "type": "string" },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "retrievalState": { "$ref": "#/$defs/retrievalState" },
        "privacyMode": { "$ref": "#/$defs/llmExecutionMode" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "summary": { "type": "string" },
        "providerCallPerformed": { "type": "boolean" },
        "externalProviderRouting": { "type": "boolean" },
        "storesRawContent": { "type": "boolean" },
        "rawContentReturned": { "type": "boolean" },
        "writesPersistentMemory": { "type": "boolean" },
        "createsEmbeddingIndex": { "type": "boolean" },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "retrievalFilterControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "controlType",
        "target",
        "defaultValue",
        "options",
        "providerCallPerformed",
        "externalProviderRouting",
        "writesPersistentMemory",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "controlType": { "enum": ["text", "select", "button"] },
        "target": { "enum": ["query", "sourceClass", "transcriptState", "reset"] },
        "defaultValue": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "providerCallPerformed": { "const": false },
        "externalProviderRouting": { "const": false },
        "writesPersistentMemory": { "const": false },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "retrievalEmptyStateTestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query",
        "sourceClass",
        "transcriptState",
        "expectedResultCardCount",
        "expectedTranscriptCount",
        "expectedResultMessage",
        "expectedTranscriptMessage",
        "providerCallPerformed",
        "externalProviderRouting",
        "writesPersistentMemory",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "query": { "type": "string" },
        "sourceClass": { "type": "string" },
        "transcriptState": { "type": "string" },
        "expectedResultCardCount": { "type": "integer", "minimum": 0 },
        "expectedTranscriptCount": { "type": "integer", "minimum": 0 },
        "expectedResultMessage": { "type": "string" },
        "expectedTranscriptMessage": { "type": "string" },
        "providerCallPerformed": { "const": false },
        "externalProviderRouting": { "const": false },
        "writesPersistentMemory": { "const": false },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "noContentSearchTranscript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query",
        "adapterId",
        "resultCount",
        "emptyState",
        "blockedSources",
        "providerCallPerformed",
        "externalProviderRouting",
        "storesRawContent",
        "rawContentReturned",
        "writesPersistentMemory",
        "createsEmbeddingIndex",
        "decisionState",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "query": { "type": "string" },
        "adapterId": { "$ref": "#/$defs/id" },
        "resultCount": { "type": "integer", "minimum": 0, "maximum": 0 },
        "emptyState": { "type": "string" },
        "blockedSources": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "providerCallPerformed": { "type": "boolean" },
        "externalProviderRouting": { "type": "boolean" },
        "storesRawContent": { "type": "boolean" },
        "rawContentReturned": { "type": "boolean" },
        "writesPersistentMemory": { "type": "boolean" },
        "createsEmbeddingIndex": { "type": "boolean" },
        "decisionState": { "enum": ["empty", "blocked"] },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requestType", "riskClass", "decisionState", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requestType": { "type": "string" },
        "riskClass": { "enum": ["low", "medium", "high", "critical"] },
        "decisionState": {
          "enum": ["not-required", "approval-needed", "approved", "denied", "blocked"]
        },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "evaluationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetType", "targetId", "result", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetType": {
          "enum": ["prompt", "route", "agent", "tool", "app-state", "retrieval", "model-research"]
        },
        "targetId": { "$ref": "#/$defs/id" },
        "result": { "enum": ["pass", "fail", "blocked", "unknown"] },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "action", "redactionState", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "actor": { "type": "string" },
        "action": { "type": "string" },
        "redactionState": { "enum": ["redacted", "metadata-only", "not-sensitive"] },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "repositoryFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "findingType", "severity", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "type": "string" },
        "findingType": { "type": "string" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "documentationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "freshness", "sourceClass", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "document": { "$ref": "#/$defs/evidenceLink" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "status": { "$ref": "#/$defs/state" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "securityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "riskClass", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "type": "string" },
        "riskClass": { "enum": ["low", "medium", "high", "critical"] },
