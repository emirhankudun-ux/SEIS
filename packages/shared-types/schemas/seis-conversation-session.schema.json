{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/ai/seis-conversation-session.schema.json",
  "title": "SEIS Conversation Session",
  "description": "Strict local/private SEIS conversation-session record. The record is stored outside Git history and never grants provider upload or GitHub publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "schemaVersion",
    "recordType",
    "id",
    "sessionName",
    "status",
    "privacyMode",
    "consent",
    "provenance",
    "provider",
    "retention",
    "redaction",
    "messageCount",
    "messages",
    "createdAt",
    "updatedAt",
    "recordHash",
    "truthBoundary"
  ],
  "properties": {
    "schemaRef": {
      "const": "packages/shared-types/schemas/seis-conversation-session.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "conversation-session"
    },
    "id": {
      "description": "Stable local session entity identifier. The runtime derives it from the normalized local session name.",
      "type": "string",
      "pattern": "^conversation:seis-agent-[a-z0-9][a-z0-9_-]{0,63}:v1$"
    },
    "sessionName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "status": {
      "const": "local-private"
    },
    "privacyMode": {
      "const": "local-only"
    },
    "consent": {
      "$ref": "#/$defs/consent"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "provider": {
      "$ref": "#/$defs/providerMetadata"
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "redaction": {
      "$ref": "#/$defs/redactionSummary"
    },
    "messageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "messages": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "recordHash": {
      "$ref": "#/$defs/hash"
    },
    "truthBoundary": {
      "const": "Local private conversation state only. It is not training data, public memory, provider-neutral context approval, model ownership evidence, or permission to publish conversation content."
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "redaction": {
            "type": "object",
            "properties": {
              "applied": {
                "const": false
              }
            },
            "required": ["applied"]
          }
        },
        "required": ["redaction"]
      },
      "then": {
        "type": "object",
        "properties": {
          "redaction": {
            "type": "object",
            "properties": {
              "replacementCount": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "redaction": {
            "type": "object",
            "properties": {
              "applied": {
                "const": true
              }
            },
            "required": ["applied"]
          }
        },
        "required": ["redaction"]
      },
      "then": {
        "type": "object",
        "properties": {
          "redaction": {
            "type": "object",
            "properties": {
              "replacementCount": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {
              "sourceType": {
                "const": "seis-agent-cli-session"
              }
            },
            "required": ["sourceType"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "type": "object",
        "properties": {
          "consent": {
            "type": "object",
            "properties": {
              "capture": {
                "const": "explicit-cli-session"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {
              "sourceType": {
                "enum": [
                  "external-chatgpt-export",
                  "external-codex-session",
                  "external-claude-export",
                  "external-qwen-export"
                ]
              }
            },
            "required": ["sourceType"]
          }
        },
        "required": ["provenance"]
      },
      "then": {
        "type": "object",
        "properties": {
          "consent": {
            "type": "object",
            "properties": {
              "capture": {
                "const": "explicit-approved-local-import"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "providerUploadAllowed",
        "githubPublicationAllowed",
        "externalSyncAllowed"
      ],
      "properties": {
        "capture": {
          "enum": ["explicit-cli-session", "explicit-approved-local-import"]
        },
        "providerUploadAllowed": {
          "const": false
        },
        "githubPublicationAllowed": {
          "const": false
        },
        "externalSyncAllowed": {
          "const": false
        }
      }
    },
    "provenance": {
      "description": "W3C PROV-aligned JSON metadata: entityId identifies the conversation entity, activityId the capture/import activity, and agentId the responsible provider profile or software agent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "activityId", "agentId", "sourceType", "sourceSessionName"],
      "properties": {
        "entityId": {
          "type": "string",
          "pattern": "^conversation:seis-agent-[a-z0-9][a-z0-9_-]{0,63}:v1$"
        },
        "activityId": {
          "type": "string",
          "pattern": "^conversation-activity:[a-f0-9]{24}$"
        },
        "agentId": {
          "type": "string",
          "pattern": "^provider-profile:[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "sourceType": {
          "enum": [
            "seis-agent-cli-session",
            "external-chatgpt-export",
            "external-codex-session",
            "external-claude-export",
            "external-qwen-export"
          ]
        },
        "sourceSessionName": {
          "description": "Normalized local alias only; raw private external identifiers and paths are not stored here.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      }
    },
    "providerMetadata": {
      "description": "Source provider/model metadata. It records origin and does not grant a provider call or upload permission.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "liveProviderUsed"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "liveProviderUsed": {
          "type": "boolean"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "expiresAt",
        "deletionSupported",
        "automaticDeletion",
        "policyReviewedAt"
      ],
      "properties": {
        "mode": {
          "const": "user-controlled"
        },
        "expiresAt": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "deletionSupported": {
          "const": true
        },
        "automaticDeletion": {
          "const": false
        },
        "policyReviewedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "redactionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "replacementCount", "policy"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "replacementCount": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "const": "seis-conversation-redaction-v1"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "role", "content", "contentHash"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "role": {
          "enum": ["user", "assistant"]
        },
        "content": {
          "$ref": "#/$defs/contentValue"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "contentValue": {
      "description": "Redacted visible user or assistant text only. Tool calls, tool results, thinking, signatures, attachments, and structured provider payloads are not persisted.",
      "type": "string",
      "maxLength": 262144
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
