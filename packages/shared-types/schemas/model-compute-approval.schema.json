{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/ai/model-compute-approval.schema.json",
  "title": "SEIS Model Compute Approval",
  "description": "Human-controlled budget and capacity authorization for one bounded model run. The record contains no provider credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRef",
    "schemaVersion",
    "recordType",
    "id",
    "recordStatus",
    "fixtureOnly",
    "recordHash",
    "previousRecordHash",
    "createdAt",
    "approved",
    "executionAllowed",
    "scope",
    "costStop",
    "expiresAt",
    "approverRole",
    "approvalId",
    "truthBoundary"
  ],
  "properties": {
    "schemaRef": {
      "const": "packages/shared-types/schemas/model-compute-approval.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "compute-approval"
    },
    "id": {
      "type": "string",
      "pattern": "^compute-approval:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "recordStatus": {
      "enum": [
        "fixture-only-not-evidence",
        "not-requested",
        "pending",
        "accepted",
        "denied",
        "expired",
        "revoked"
      ]
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "recordHash": {
      "$ref": "#/$defs/hash"
    },
    "previousRecordHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "createdAt": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "approved": {
      "type": "boolean"
    },
    "executionAllowed": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelClass",
        "methods",
        "provider",
        "hardwareClass",
        "region",
        "maxBudgetUsd",
        "maxGpuHours"
      ],
      "properties": {
        "modelClass": {
          "enum": ["seed", "small", "20B", "70B", "150B", "300B+", "512B"]
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["inference", "pretraining", "sft", "dpo", "lora-adapter", "benchmark"]
          }
        },
        "provider": {
          "type": ["string", "null"],
          "minLength": 2
        },
        "hardwareClass": {
          "type": "string",
          "minLength": 2
        },
        "region": {
          "type": ["string", "null"],
          "minLength": 2
        },
        "maxBudgetUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxGpuHours": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "costStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hardLimitUsd", "ownerRole"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hardLimitUsd": {
          "type": "number",
          "minimum": 0
        },
        "ownerRole": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "expiresAt": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "approverRole": {
      "type": ["string", "null"],
      "minLength": 3
    },
    "approvalId": {
      "type": ["string", "null"],
      "pattern": "^approval:[a-z0-9][a-z0-9._-]{2,}:v[0-9]+$"
    },
    "truthBoundary": {
      "type": "string",
      "minLength": 24
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableTimestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    }
  }
}
