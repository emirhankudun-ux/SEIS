{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seis.dev/schemas/tool-registry-permissions.schema.json",
  "title": "SEIS Tool Registry Permission Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "status",
    "sourceDocuments",
    "riskClasses",
    "permissionStates",
    "tools",
    "nonClaims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": ["fixture-backed", "blocked"]
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "riskClasses": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/riskClass"
      },
      "uniqueItems": true
    },
    "permissionStates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/permissionState"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(docs|packages|roadmap|reports|apps|content|data|scripts)/|^SECURITY\\.md$"
    },
    "riskClass": {
      "enum": [
        "read-only",
        "local-write",
        "external-read",
        "external-write",
        "privileged",
        "destructive"
      ]
    },
    "permissionState": {
      "enum": [
        "allowed",
        "scoped",
        "approval-needed",
        "blocked",
        "disabled"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "toolName",
        "surfaceType",
        "riskClass",
        "permissionState",
        "approvalState",
        "allowedActions",
        "forbiddenActions",
        "approvalGates",
        "validation",
        "auditMetadata",
        "sourceLinks",
        "status",
        "maturity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "toolName": {
          "type": "string"
        },
        "surfaceType": {
          "enum": [
            "cli-script",
            "mcp-tool",
            "plugin",
            "provider-api",
            "ssh-operation"
          ]
        },
        "riskClass": {
          "$ref": "#/$defs/riskClass"
        },
        "permissionState": {
          "$ref": "#/$defs/permissionState"
        },
        "approvalState": {
          "enum": [
            "not-required",
            "approval-needed",
            "approved",
            "denied",
            "blocked"
          ]
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "forbiddenActions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "approvalGates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "auditMetadata": {
          "$ref": "#/$defs/auditMetadata"
        },
        "sourceLinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "status": {
          "enum": [
            "planned",
            "blocked",
            "approval-needed",
            "validated"
          ]
        },
        "maturity": {
          "enum": [
            "fixture-backed",
            "local-alpha",
            "draft",
            "blocked"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence", "notes"],
      "properties": {
        "result": {
          "enum": ["pass", "blocked", "unknown"]
        },
        "evidence": {
          "$ref": "#/$defs/repoPath"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redactionState",
        "toolExecuted",
        "writesPerformed",
        "externalNetworkUsed",
        "privilegedOperationPerformed",
        "secretMaterialAccessible",
        "safeMetadata"
      ],
      "properties": {
        "redactionState": {
          "enum": ["metadata-only", "redacted", "not-sensitive"]
        },
        "toolExecuted": {
          "const": false
        },
        "writesPerformed": {
          "const": false
        },
        "externalNetworkUsed": {
          "const": false
        },
        "privilegedOperationPerformed": {
          "const": false
        },
        "secretMaterialAccessible": {
          "const": false
        },
        "safeMetadata": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
