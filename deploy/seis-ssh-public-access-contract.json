{
  "version": 1,
  "id": "seis-ssh-public-access-contract",
  "title": "SEIS SSH Public GitHub Access Contract",
  "status": "active",
  "targetAlias": "SEIS-SSH",
  "sourceModel": "deploy/seis-ssh-access-model.json",
  "sourceRoadmap": "deploy/seis-ssh-cloud-roadmap.json",
  "audience": [
    "github-contributors",
    "individual-users",
    "chatgpt-codex-users",
    "maintainers",
    "companies-and-teams"
  ],
  "serverAndPortPolicy": {
    "mode": "preserve-existing-server-and-port",
    "turkishInvariant": "Ayni sunucu ve baglanti noktasi korunur.",
    "englishInvariant": "Keep the same server and port.",
    "currentAlias": "SEIS-SSH",
    "hostSourceOrder": [
      "existing ~/.ssh/config HostName for SEIS-SSH",
      "SEIS_SSH_HOST only when installing a new direct-cloud endpoint with explicit owner approval"
    ],
    "portSourceOrder": [
      "existing ~/.ssh/config Port for SEIS-SSH",
      "SEIS_SSH_PORT only when installing a new direct-cloud endpoint with explicit owner approval",
      "default 22 only when no existing Port is configured"
    ],
    "forbiddenActions": [
      "change-host-to-localhost",
      "change-host-to-lan-name",
      "change-port-without-owner-approval",
      "create-new-visible-alias-for-same-target",
      "overwrite-unmanaged-seis-ssh-block-by-default"
    ],
    "requiredInvariant": "Do not change the current SEIS-SSH server or connection port during onboarding, docs, checks, demos, or config generation unless the human owner explicitly approves endpoint migration."
  },
  "githubExperience": {
    "publicPromise": "One memorable SEIS-SSH entrypoint, no secrets in git, no fake online status, no local Mac dependency, a contributor-friendly runbook, and a secret-safe GitHub support form.",
    "visibleName": "SEIS-SSH",
    "supportIssueTemplate": ".github/ISSUE_TEMPLATE/seis_ssh_access.yml",
    "pullRequestTemplate": ".github/PULL_REQUEST_TEMPLATE.md",
    "ciWorkflow": ".github/workflows/seis-ssh-public-access.yml",
    "mergeReadinessReport": "npm run report:seis-ssh-public-merge-readiness",
    "policyDoctor": "npm run report:seis-ssh-public-github-policy",
    "signingGuide": "npm run report:seis-ssh-public-signing-guide",
    "reviewBundle": "npm run report:seis-ssh-public-review-bundle",
    "aiMcpHandoff": "npm run report:seis-ssh-ai-mcp-handoff",
    "clientCompatibility": "npm run report:seis-ssh-public-client-compatibility",
    "openSourceStatus": "review-ready-contract",
    "claimAllowedOnlyWhen": [
      "SEIS-SSH remains the only visible SEIS SSH alias",
      "existing server and port are preserved",
      "docs explain real, mock, disabled, and planned states",
      "no private keys, tokens, provider keys, or .env values are committed",
      "strict online evidence exists before live-ready claims"
    ],
    "claimBlockedWhen": [
      "host or port is changed without explicit owner approval",
      "SEIS-SSH points at localhost or a LAN host",
      "a second visible SEIS SSH alias is added",
      "the public docs imply SSH is live without strict evidence",
      "a private key, classic GitHub token, fine-grained GitHub token, provider key, or .env secret appears in repo artifacts"
    ]
  },
  "profiles": [
    {
      "id": "github-reader",
      "audience": "github-contributors",
      "status": "documented",
      "entrypoint": "docs/deployment/seis-ssh-public-github-access.md",
