        "run the read-only public access CI workflow check",
        "run the read-only public readiness matrix",
        "run the read-only artifact hygiene check",
        "run the read-only contributor doctor",
        "open the secret-safe GitHub issue form",
        "open the SEIS Cloud demo surface"
      ],
      "forbiddenActions": [
        "execute live SSH without approval",
        "change HostName or Port",
        "commit secrets"
      ]
    },
    {
      "id": "individual-user",
