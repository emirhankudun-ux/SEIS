{
  "version": 1,
  "id": "seis-ssh-public-access-contract",
  "title": "SEIS SSH Public GitHub Access Contract",
  "status": "active",
  "targetAlias": "SEIS-SSH",
  "sourceModel": "deploy/seis-ssh-access-model.json",
  "sourceRoadmap": "deploy/seis-ssh-cloud-roadmap.json",
  "audience": [
    "github-contributors",
    "individual-users",
    "chatgpt-codex-users",
    "maintainers",
    "companies-and-teams"
  ],
  "serverAndPortPolicy": {
    "mode": "preserve-existing-server-and-port",
    "turkishInvariant": "Ayni sunucu ve baglanti noktasi korunur.",
    "englishInvariant": "Keep the same server and port.",
    "currentAlias": "SEIS-SSH",
    "hostSourceOrder": [
      "existing ~/.ssh/config HostName for SEIS-SSH",
      "SEIS_SSH_HOST only when installing a new direct-cloud endpoint with explicit owner approval"
    ],
    "portSourceOrder": [
      "existing ~/.ssh/config Port for SEIS-SSH",
      "SEIS_SSH_PORT only when installing a new direct-cloud endpoint with explicit owner approval",
      "default 22 only when no existing Port is configured"
    ],
    "forbiddenActions": [
      "change-host-to-localhost",
      "change-host-to-lan-name",
      "change-port-without-owner-approval",
      "create-new-visible-alias-for-same-target",
      "overwrite-unmanaged-seis-ssh-block-by-default"
    ],
    "requiredInvariant": "Do not change the current SEIS-SSH server or connection port during onboarding, docs, checks, demos, or config generation unless the human owner explicitly approves endpoint migration."
  },
  "githubExperience": {
    "publicPromise": "One memorable SEIS-SSH entrypoint, no secrets in git, no fake online status, no local Mac dependency, and a contributor-friendly runbook.",
    "visibleName": "SEIS-SSH",
    "openSourceStatus": "review-ready-contract",
    "claimAllowedOnlyWhen": [
      "SEIS-SSH remains the only visible SEIS SSH alias",
      "existing server and port are preserved",
      "docs explain real, mock, disabled, and planned states",
      "no private keys, tokens, provider keys, or .env values are committed",
      "strict online evidence exists before live-ready claims"
    ],
    "claimBlockedWhen": [
      "host or port is changed without explicit owner approval",
      "SEIS-SSH points at localhost or a LAN host",
      "a second visible SEIS SSH alias is added",
      "the public docs imply SSH is live without strict evidence",
      "a private key or token appears in repo artifacts"
    ]
  },
  "profiles": [
    {
      "id": "github-reader",
      "audience": "github-contributors",
      "status": "documented",
      "entrypoint": "docs/deployment/seis-ssh-public-github-access.md",
      "allowedActions": [
        "read the runbook",
        "run static checks",
        "run the read-only first-run guide",
        "run the read-only troubleshooting guide",
        "run the read-only contributor doctor",
        "open the SEIS Cloud demo surface"
      ],
      "forbiddenActions": [
        "execute live SSH without approval",
        "change HostName or Port",
        "commit secrets"
      ]
    },
    {
      "id": "individual-user",
      "audience": "individual-users",
      "status": "cloud-ready-when-verified",
      "entrypoint": "SEIS-SSH",
      "requiredEvidence": [
        "npm run check:seis-ssh-public-access",
        "npm run check:seis-ssh-public-first-run",
        "npm run check:seis-ssh-public-troubleshooting",
        "npm run check:seis-ssh-public-contributor-doctor",
        "npm run check:seis-ssh-picker-compatibility",
        "npm run cloud:ssh:online:strict"
      ]
    },
    {
      "id": "organization-team",
      "audience": "companies-and-teams",
      "status": "vpn-gated",
      "entrypoint": "SEIS-SSH",
      "requiredEvidence": [
        "npm run check:ssh-vpn-cloud-server",
        "approved peer inventory",
        "no broad VPN source ranges"
      ]
    },
    {
      "id": "maintainer",
      "audience": "maintainers",
      "status": "approval-gated",
      "entrypoint": "SEIS-SSH",
      "requiredEvidence": [
        "preserve existing HostName",
        "preserve existing Port",
        "record any endpoint migration as a reviewed change"
      ]
    }
  ],
  "evidenceSurfaces": [
    "docs/deployment/seis-ssh-public-github-access.md",
    "docs/deployment/seis-ssh-access-model.md",
    "docs/deployment/seis-ssh-cloud-roadmap.md",
    "deploy/seis-ssh-access-model.json",
    "deploy/seis-ssh-cloud-roadmap.json",
    "scripts/check-seis-ssh-public-access.mjs",
    "scripts/create-seis-ssh-public-access-report.mjs",
    "scripts/create-seis-ssh-public-first-run.mjs",
    "scripts/create-seis-ssh-public-troubleshooting-guide.mjs",
    "scripts/create-seis-ssh-public-onboarding-pack.mjs",
    "scripts/check-seis-ssh-public-contributor-doctor.mjs",
    "scripts/check-seis-ssh-live-readiness-evidence.mjs",
    "content/development/seis-ssh-live-readiness-evidence.json",
    "docs/deployment/seis-ssh-live-readiness-evidence.md",
    "apps/web/desktop.js",
    "README.md",
    "docs/STATUS.md",
    "docs/roadmap/MASTER_BACKLOG.md",
    "docs/roadmap/NEXT_PR_QUEUE.md"
  ],
  "qualityGate": "npm run check:seis-ssh-public-access",
  "requiredCommands": [
    "npm run check:seis-ssh-public-access",
    "npm run check:seis-ssh-public-access-report",
    "npm run report:seis-ssh-public-access",
    "npm run check:seis-ssh-public-first-run",
    "npm run report:seis-ssh-public-first-run",
    "npm run check:seis-ssh-public-troubleshooting",
    "npm run report:seis-ssh-public-troubleshooting",
    "npm run check:seis-ssh-public-onboarding",
    "npm run report:seis-ssh-public-onboarding",
    "npm run check:seis-ssh-public-contributor-doctor",
    "npm run report:seis-ssh-public-contributor-doctor",
    "npm run check:seis-ssh-live-readiness-evidence",
    "npm run check:seis-ssh-access-model",
    "npm run check:seis-ssh-picker-compatibility",
    "npm run check:seis-ssh-cloud-roadmap",
    "npm run check:seis-ssh-closed-runtime",
    "npm run check:seis-ssh-mobile-direct-cloud",
    "npm run check:seis-ssh-enterprise-benchmark"
  ],
  "approvalGates": [
    "change-server-or-port",
    "install-managed-ssh-config",
    "bootstrap-remote-vm",
    "execute-live-ssh",
    "change-firewall-or-sshd",
    "push-merge-or-release"
  ],
  "nonGoals": [
    "public shared SSH credentials",
    "anonymous shell access",
    "host or port migration in this contract",
    "fake connected status",
    "secrets in frontend or git"
  ]
}
