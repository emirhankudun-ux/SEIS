        "question": "Which public domain or preview URL should serve the release?",
        "blocks": ["domain", "origin"]
      },
      {
        "id": "document-root",
        "question": "Which exact document root or deploy path is safe to overwrite?",
        "blocks": ["path", "document_root"]
      },
      {
        "id": "rollback-owner",
        "question": "Who confirms rollback if the upload exposes the wrong version?",
        "blocks": ["rollback_contact"]
      }
    ],
    "safeDefault": "keep activeTarget null until all required questions are answered"
