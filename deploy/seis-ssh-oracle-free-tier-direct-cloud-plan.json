    "ownerPreflight": "npm run cloud:ssh:oracle-owner:preflight",
    "checkOwnerPreflight": "npm run check:seis-ssh-oracle-owner-preflight",
    "ownerLaunchCommand": "npm run cloud:ssh:oracle-owner:launch-command",
    "checkOwnerLaunchCommand": "npm run check:seis-ssh-oracle-owner-launch-command",
    "ownerHandoff": "npm run cloud:ssh:oracle-owner:handoff",
    "checkOwnerHandoff": "npm run check:seis-ssh-oracle-owner-handoff",
    "postBootHandoff": "npm run cloud:ssh:oracle-postboot:handoff",
    "checkPostBootHandoff": "npm run check:seis-ssh-oracle-postboot-handoff",
    "directCloudPipeline": "npm run cloud:ssh:oracle-direct-cloud:pipeline",
    "checkDirectCloudPipeline": "npm run check:seis-ssh-oracle-direct-cloud-pipeline",
    "githubCodespacesFallbackPlan": "npm run cloud:ssh:github-codespaces:fallback-plan",
    "checkGithubCodespacesFallbackPlan": "npm run check:seis-ssh-github-codespaces-fallback-plan",
    "oracleLogin": "oci session authenticate --region eu-frankfurt-1 --no-browser --profile-name SEIS",
    "afterVmExists": "npm run cloud:ssh:direct-cloud:activate -- --public-ip <PUBLIC_IP> --direct-user aiuser",
    "strictProbe": "npm run cloud:ssh:mobile-direct:probe:strict",
    "strictDoctor": "npm run cloud:ssh:mobile-direct:doctor:strict",
    "readinessClaim": "npm run cloud:ssh:direct-cloud:claim"
  },
  "security": [
    "Reports may include only redacted path, fingerprint, and boolean readiness facts.",
    "Private key material is never read.",
    "OCI profile files are only detected by path existence; their contents are not read.",
    "Owner input template files are ignored and must stay local.",
    "Owner input template generation preserves existing local values unless --force is explicitly used after review.",
    "Owner preflight reports only presence, detected kind, and SHA-256 prefixes for OCIDs and endpoints.",
    "Owner launch-command JSON and Markdown reports never print raw owner values; the raw command may exist only in an ignored local shell handoff.",
    "Owner handoff bundle reports only redacted report statuses, next action, and run order.",
    "Direct-cloud activation output is redacted and uses endpoint kind plus SHA-256 prefix for continuity.",
    "Cloud-init handoff output is local-only and ignored because it embeds the public SSH key.",
    "Live provider calls are outside this planner and require owner approval."
  ]
}
