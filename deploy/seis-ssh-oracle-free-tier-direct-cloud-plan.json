  "positioning": {
    "role": "first always-on direct-cloud VM attempt",
    "why": "Oracle Cloud Free Tier can provide an always-on compute target for SEIS-SSH when account login, tenancy, capacity, and SSH key installation are available.",
    "notAReplacementFor": [
      "strict direct-cloud probe",
      "strict direct-cloud doctor",
      "owner-approved endpoint migration"
    ]
  },
  "safeWithoutOracleLogin": [
    "Verify the OCI CLI binary is available locally.",
    "Verify the SEIS public key exists without reading private key material.",
    "Inspect the current SEIS-SSH alias shape with ssh -G.",
    "Generate redacted local reports.",
    "Generate a local-only Oracle cloud-init handoff YAML that embeds the SEIS public key.",
    "Generate a local-only Oracle instance launch command plan with owner-input placeholders.",
    "Generate a local-only ignored owner-input env template for Oracle compartment, subnet, image, availability-domain, and post-boot endpoint values.",
    "Generate a local-only owner preflight report that checks OCI session hints and redacted owner-input presence.",
    "Generate a local-only ignored launch-command handoff shell script only after owner inputs have valid shapes.",
    "Generate a local-only owner handoff bundle with redacted run order and current blockers.",
    "Generate a local-only post-boot handoff report after Oracle assigns a public endpoint.",
    "Generate a local-only pipeline report that summarizes the current blocked stage.",
    "Keep GitHub Codespaces as the fallback until a real Oracle endpoint exists."
  ],
  "requiresOwnerOutsideGit": [
    "Oracle account login and session setup",
    "Tenancy, region, and compartment selection",
    "Always Free VM capacity confirmation",
    "Public IPv4 or approved DNS endpoint assignment",
    "Cloud-init user-data paste at first boot",
    "SEIS public key installation on the VM",
    "Any Cloudflare Access tunnel, cert, or token setup"
  ],
  "phases": [
    {
      "id": "local-preflight",
      "readyWhen": [
        "npm run check:seis-ssh-oracle-free-tier-plan passes",
        "OCI CLI is available",
        "SEIS public key is present"
      ]
    },
    {
      "id": "owner-oracle-auth",
      "readyWhen": [
        "Oracle browser/device login is completed outside git",
        "Profile and region are selected without committing OCI files"
      ]
    },
    {
      "id": "owner-preflight",
      "readyWhen": [
        "npm run check:seis-ssh-oracle-owner-preflight passes",
        "npm run check:seis-ssh-oracle-owner-input-template passes",
        "npm run cloud:ssh:oracle-owner:preflight shows local artifacts ready",
        "Availability domain, compartment OCID, public subnet OCID, and image OCID are present only as redacted owner inputs with valid shapes"
      ]
    },
    {
      "id": "owner-launch-command",
      "readyWhen": [
        "npm run check:seis-ssh-oracle-owner-launch-command passes",
        "npm run cloud:ssh:oracle-owner:launch-command writes only ignored local artifacts",
        "JSON and Markdown reports do not print raw OCIDs, availability-domain values, endpoints, or the raw OCI launch command"
      ]
    },
    {
      "id": "vm-selection",
      "readyWhen": [
        "Always Free compatible VM exists",
        "Public endpoint is available",
        "SSH port policy is reviewed"
      ]
    },
    {
      "id": "cloud-init-handoff",
      "readyWhen": [
        "npm run check:seis-ssh-oracle-cloud-init-handoff passes",
        "Generated cloud-init YAML is reviewed locally",
        "Cloud-init YAML is pasted into Oracle user-data before first boot"
      ]
    },
    {
      "id": "public-key-install",
      "readyWhen": [
        "SEIS public key is installed in the remote authorized_keys",
        "No SSH private key is copied to Oracle or git"
      ]
    },
    {
      "id": "single-alias-activation",
      "readyWhen": [
        "npm run cloud:ssh:direct-cloud:activate -- --public-ip <PUBLIC_IP> --direct-user aiuser is owner-approved",
        "SEIS-SSH remains the only visible alias"
      ]
    },
    {
      "id": "post-boot-handoff",
      "readyWhen": [
        "npm run check:seis-ssh-oracle-postboot-handoff passes",
        "npm run cloud:ssh:oracle-postboot:handoff records endpoint continuity without printing the endpoint",
        "Owner run order points to switch, activate, strict probe, strict doctor, and claim gate"
      ]
    },
    {
      "id": "strict-proof",
      "readyWhen": [
        "npm run cloud:ssh:mobile-direct:probe:strict passes",
        "npm run cloud:ssh:mobile-direct:doctor:strict passes"
      ]
    },
    {
      "id": "optional-cloudflare-access",
      "readyWhen": [
        "A real cloud VM origin already exists",
        "Cloudflare Access policy is identity-gated",
        "No tunnel token, cert, or origin credential is committed"
      ]
    }
  ],
  "readinessBlockersUntilProven": [
    "Oracle account session is not proven by local planning.",
    "Tenancy, compartment, and capacity are not proven by local planning.",
    "No Oracle VM endpoint exists in git-safe metadata.",
    "Oracle cloud-init user-data has not been applied to a real VM.",
    "SEIS public key installation on the VM is not proven.",
    "Strict direct-cloud probe and doctor have not passed."
  ],
  "forbiddenActions": [
    "commit OCI config, session files, private keys, tunnel certs, or tokens",
    "print Oracle OCIDs, hostnames, public IPs, or session details in public reports",
    "claim ChatGPT mobile 24x7 readiness before strict probe and doctor pass",
    "expose the local Mac through Cloudflare as the default SEIS-SSH path",
    "add a duplicate visible SSH alias to make pickers look online"
  ],
  "commands": {
    "localPlan": "npm run cloud:ssh:oracle-free-tier:plan",
