        "ssh -G SEIS-SSH resolves without ProxyCommand after approved migration",
        "npm run cloud:ssh:mobile-direct:probe:strict passes",
        "npm run cloud:ssh:mobile-direct:doctor:strict passes",
        "npm run cloud:ssh:direct-cloud:claim allows the readiness claim"
      ],
      "blockers": [
        "no Oracle login session",
        "no tenancy or compartment selected",
        "no available free-tier VM capacity",
        "public key not installed on the VM"
      ],
      "forbiddenActions": [
        "commit OCI config, private keys, or session files",
        "claim 24x7 readiness before strict probe and doctor pass",
        "open broad root SSH without review"
      ]
    },
