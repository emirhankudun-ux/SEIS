  "forbiddenDefaultPaths": [
    {
      "id": "local-mac-cloudflare-tunnel",
      "reason": "It depends on the local Mac staying online and exposes a personal workstation as infrastructure.",
      "allowedOnlyWhen": "Explicit owner approval records this as temporary debugging, not public SEIS-SSH readiness."
    },
    {
      "id": "shared-private-key",
      "reason": "SEIS never shares private SSH keys between contributors, agents, or cloud providers.",
      "allowedOnlyWhen": "never"
    },
    {
      "id": "duplicate-picker-alias",
      "reason": "SEIS-SSH must remain the single visible SSH target.",
