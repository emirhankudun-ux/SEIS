      "requiresLocalPrivateKeySharing": false,
      "requiredEvidence": [
        "gh auth has codespace scope",
        "Codespace exists and is running",
        "SEIS-SSH resolves to github.codespaces with ProxyCommand",
        "npm run cloud:ssh:online:strict passes when budget and workspace state allow it"
      ],
      "blockers": [
        "codespace can sleep",
        "monthly budget or spending limit can block startup",
        "ProxyCommand can appear offline in generic SSH pickers"
      ],
      "forbiddenActions": [
        "claim Codespaces is mobile 24x7 direct-cloud SSH",
