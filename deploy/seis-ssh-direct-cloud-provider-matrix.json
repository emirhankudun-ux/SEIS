      "requiresAccount": true,
      "requiresBillingOrTenancy": false,
      "requiresPublicKeyInstall": false,
      "requiresLocalPrivateKeySharing": false,
      "requiredEvidence": [
        "Cloudflare account and tunnel are authenticated outside git",
        "Origin is an approved cloud VM, not the local Mac",
        "Access policy is identity-gated",
        "No tunnel token, cert, or origin credential is committed",
        "Strict SSH probe passes through the approved access path"
      ],
      "blockers": [
        "Cloudflare does not provide the VM by itself",
        "local Mac tunneling is not acceptable as the default SEIS-SSH path",
        "cloudflared login/cert/token must stay outside git"
      ],
      "forbiddenActions": [
