  "decisionPolicy": {
    "goal": "Choose a provider path that can make SEIS-SSH usable from ChatGPT mobile and Codex without depending on the local Mac.",
    "singleAliasInvariant": "SEIS-SSH",
    "serverAndPortInvariant": "Keep the same server and port until an owner-approved endpoint migration is recorded.",
    "recommendedOrder": [
      "oracle-cloud-free-tier",
      "github-codespaces",
      "cloudflare-access-tunnel",
      "google-cloud-compute"
    ],
    "activeRecommendation": {
      "path": "oracle-cloud-free-tier -> direct-cloud SSH -> optional Cloudflare Access layer -> SEIS-SSH",
      "reason": "Oracle Cloud Free Tier is the best fit for an always-on no-cost VM when account login, tenancy, capacity, and key installation are available.",
      "currentStatus": "blocked-until-cloud-account-and-instance-exist"
    }
  },
