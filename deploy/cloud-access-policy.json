{
  "version": 1,
  "id": "seis-cloud-access-policy",
  "publicCloud": {
    "audience": "everyone",
    "purpose": "public product, documentation, site, release, and preview surfaces",
    "vpnRequired": false,
    "providers": [
      "github-pages",
      "cloudflare-pages",
      "vercel-static",
      "netlify-static",
      "azure-static-web-apps",
      "aws-amplify-static",
      "firebase-hosting",
      "hostinger-static",
      "apache-shared-hosting"
    ]
  },
  "sshAccessModel": {
    "source": "deploy/seis-ssh-access-model.json",
    "visibleAlias": "SEIS-SSH",
    "cloudOnly": true,
    "individualUsers": {
      "mode": "normal-cloud-ssh",
      "vpnRequired": false,
      "transport": "github-codespaces"
    },
    "companiesAndTeams": {
      "mode": "vpn-cloud-ssh",
      "vpnRequired": true,
      "transport": "wireguard-or-equivalent-peer-authenticated-vpn"
    },
    "developers": {
      "mode": "closed-cloud-development-system",
      "vpnRequiredForSensitiveWork": true,
      "publicInboundRequired": false
    }
  },
  "teamVpnCloud": {
    "audience": "workplaces-and-teams",
    "purpose": "private engineering, Codex remote host, handoff, and operational workspace",
    "vpnRequired": true,
    "providers": [
      "gcp-compute-vm",
      "ssh-wireguard-vps",
      "node-vps",
      "docker-node-static",
      "generic-sftp"
    ],
    "rules": [
      "Use WireGuard or an equivalent peer-authenticated VPN for private cloud workspaces.",
      "Add only approved workplace or team peers.",
      "Use per-peer /32 VPN addresses.",
      "Do not expose team VPN cloud as a public everyone surface.",
      "Do not use 0.0.0.0/0 or ::/0 for VPN source ranges."
    ]
  }
}
